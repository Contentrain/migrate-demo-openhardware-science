---
// The roadmap's concrete actions, set as a report's numbered list of actions: a purple tile per action, ruled rows.
import { safeHref } from '../kit/_shared/safe-url'

interface Item {
  href?: string | undefined
  linkLabel?: string | undefined
  meta?: string | undefined
  text?: string | undefined
  title?: string | undefined
  value?: string | undefined
}

interface Props {
  id: string
  eyebrow?: string | undefined
  heading?: string | undefined
  items: Item[]
  actions: Array<{ href: string, label: string, newTab?: boolean | undefined }>
}

const { id, eyebrow, heading, items, actions } = Astro.props
const titleId = `${id}-title`
---
<section id={id} class="container-page py-12 md:py-16" aria-labelledby={heading?.trim() ? titleId : undefined}>
  <div class="md:ps-[15%]">
    {eyebrow && <p class="mb-2 text-sm font-semibold text-ink-muted">{eyebrow}</p>}
    {heading?.trim() && <h2 id={titleId} class="mb-8 text-3xl font-extrabold tracking-tight text-balance md:text-4xl">{heading}</h2>}
    {items.length > 0 && (
      <ol class="grid border-b-2 border-ink" role="list">
        {items.map((item, index) => (
          <li class="grid grid-cols-[3rem_1fr] items-start gap-4 border-t-2 border-ink py-5 md:grid-cols-[4rem_1fr] md:gap-8 md:py-6">
            <span class="flex size-12 items-center justify-center bg-accent text-lg font-extrabold text-accent-ink md:size-16 md:text-2xl" aria-hidden="true">{item.value ?? String(index + 1)}</span>
            <div class="max-w-[68ch] self-center">
              {item.title && <p class="text-lg font-bold">{item.title}</p>}
              {item.meta && <p class="text-sm text-ink-muted">{item.meta}</p>}
              {item.text && <p class="text-lg leading-snug md:text-xl">{item.text}</p>}
              {item.href && (
                <a href={safeHref(item.href)} class="mt-2 inline-flex min-h-11 items-center font-semibold text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{item.linkLabel ?? item.title ?? item.href}</a>
              )}
            </div>
          </li>
        ))}
      </ol>
    )}
    {actions.length > 0 && (
      <p class="mt-8 flex flex-wrap gap-4">
        {actions.map(action => (
          <a href={safeHref(action.href)} target={action.newTab ? '_blank' : undefined} rel={action.newTab ? 'noopener' : undefined} class="inline-flex min-h-11 items-center bg-accent px-5 font-semibold text-accent-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{action.label}</a>
        ))}
      </p>
    )}
  </div>
</section>
