---
// Generated by Contentrain Migrate from the plan route `page-2023-gosh-community-council-election`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const page2023GoshCommunityCouncilElection = await getEntry('page2023GoshCommunityCouncilElection', 'en')
if (!page2023GoshCommunityCouncilElection) throw new Error('page-2023-gosh-community-council-election is missing: the page\'s sections are its fields')
const { gosh_community_council: goshCommunityCouncil, timeline, how_do_i: howDoI } = page2023GoshCommunityCouncilElection.data
const goshCommunityCouncilHtml = await publicHtml(goshCommunityCouncil?.html)
const prose0 = headingLevels(goshCommunityCouncil?.markdown, 1)
const timelineActions = (timeline?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const timelineItems = (timeline?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const howDoIHtml = await publicHtml(howDoI?.html)
const h2Above2 = prose0.top !== undefined || !!(timeline && (!!timeline?.heading?.trim() || (timeline?.items?.length ?? 0) > 0))
const prose1 = headingLevels(howDoI?.markdown, h2Above2 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {goshCommunityCouncil && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={goshCommunityCouncilHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {timeline && (
    <Band
      actions={timelineActions}
      eyebrow={timeline.eyebrow}
      heading={timeline.heading}
      items={timelineItems}
      lead={timeline.lead}
      media={timeline.media}
      columns="4"
      entry="timeline"
    />
  )}
  {howDoI && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose html={howDoIHtml} markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
</ComposedPage>
