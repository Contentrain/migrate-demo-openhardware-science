---
// Generated by Contentrain Migrate from the plan route `page-schedule`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageSchedule = await getEntry('pageSchedule', 'en')
if (!pageSchedule) throw new Error('page-schedule is missing: the page\'s sections are its fields')
const { text, wednesday_march_22nd: wednesdayMarch22nd, wednesday_march_22nd_note: wednesdayMarch22ndNote, thursday_march_23rd: thursdayMarch23rd, thursday_march_23rd_note: thursdayMarch23rdNote, friday_march_24th: fridayMarch24th, friday_march_24th_note: fridayMarch24thNote, saturday_march_25th: saturdayMarch25th, saturday_march_25th_note: saturdayMarch25thNote, day_5_6: day56Section } = pageSchedule.data
const textHtml = await publicHtml(text?.html)
const prose0 = headingLevels(text?.markdown, 1)
const wednesdayMarch22ndActions = (wednesdayMarch22nd?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const wednesdayMarch22ndItems = (wednesdayMarch22nd?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const wednesdayMarch22ndNoteHtml = await publicHtml(wednesdayMarch22ndNote?.html)
const h2Above2 = prose0.top !== undefined || !!(wednesdayMarch22nd && (!!wednesdayMarch22nd?.heading?.trim() || (wednesdayMarch22nd?.items?.length ?? 0) > 0))
const prose1 = headingLevels(wednesdayMarch22ndNote?.markdown, h2Above2 ? 2 : 1)
const thursdayMarch23rdActions = (thursdayMarch23rd?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const thursdayMarch23rdItems = (thursdayMarch23rd?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const thursdayMarch23rdNoteHtml = await publicHtml(thursdayMarch23rdNote?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined || !!(thursdayMarch23rd && (!!thursdayMarch23rd?.heading?.trim() || (thursdayMarch23rd?.items?.length ?? 0) > 0))
const prose3 = headingLevels(thursdayMarch23rdNote?.markdown, h2Above4 ? 2 : 1)
const fridayMarch24thActions = (fridayMarch24th?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const fridayMarch24thItems = (fridayMarch24th?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const fridayMarch24thNoteHtml = await publicHtml(fridayMarch24thNote?.html)
const h2Above6 = h2Above4 || prose3.top !== undefined || !!(fridayMarch24th && (!!fridayMarch24th?.heading?.trim() || (fridayMarch24th?.items?.length ?? 0) > 0))
const prose5 = headingLevels(fridayMarch24thNote?.markdown, h2Above6 ? 2 : 1)
const saturdayMarch25thActions = (saturdayMarch25th?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const saturdayMarch25thItems = (saturdayMarch25th?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const saturdayMarch25thNoteHtml = await publicHtml(saturdayMarch25thNote?.html)
const h2Above8 = h2Above6 || prose5.top !== undefined || !!(saturdayMarch25th && (!!saturdayMarch25th?.heading?.trim() || (saturdayMarch25th?.items?.length ?? 0) > 0))
const prose7 = headingLevels(saturdayMarch25thNote?.markdown, h2Above8 ? 2 : 1)
const day56SectionHtml = await publicHtml(day56Section?.html)
const h2Above10 = h2Above8 || prose7.top !== undefined
const prose9 = headingLevels(day56Section?.markdown, h2Above10 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {wednesdayMarch22nd && (
    <Band
      actions={wednesdayMarch22ndActions}
      eyebrow={wednesdayMarch22nd.eyebrow}
      heading={wednesdayMarch22nd.heading}
      items={wednesdayMarch22ndItems}
      lead={wednesdayMarch22nd.lead}
      media={wednesdayMarch22nd.media}
      columns="4"
      entry="wednesday_march_22nd"
    />
  )}
  {wednesdayMarch22ndNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose html={wednesdayMarch22ndNoteHtml} markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {thursdayMarch23rd && (
    <Band
      actions={thursdayMarch23rdActions}
      eyebrow={thursdayMarch23rd.eyebrow}
      heading={thursdayMarch23rd.heading}
      items={thursdayMarch23rdItems}
      lead={thursdayMarch23rd.lead}
      media={thursdayMarch23rd.media}
      entry="thursday_march_23rd"
    />
  )}
  {thursdayMarch23rdNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose html={thursdayMarch23rdNoteHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
  {fridayMarch24th && (
    <Band
      actions={fridayMarch24thActions}
      eyebrow={fridayMarch24th.eyebrow}
      heading={fridayMarch24th.heading}
      items={fridayMarch24thItems}
      lead={fridayMarch24th.lead}
      media={fridayMarch24th.media}
      entry="friday_march_24th"
    />
  )}
  {fridayMarch24thNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose5.shift}>
      <Prose html={fridayMarch24thNoteHtml} markdown={fitHeadings(prose5.markdown)} />
    </div>
  )}
  {saturdayMarch25th && (
    <Band
      actions={saturdayMarch25thActions}
      eyebrow={saturdayMarch25th.eyebrow}
      heading={saturdayMarch25th.heading}
      items={saturdayMarch25thItems}
      lead={saturdayMarch25th.lead}
      media={saturdayMarch25th.media}
      entry="saturday_march_25th"
    />
  )}
  {saturdayMarch25thNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose7.shift}>
      <Prose html={saturdayMarch25thNoteHtml} markdown={fitHeadings(prose7.markdown)} />
    </div>
  )}
  {day56Section && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose9.shift}>
      <Prose html={day56SectionHtml} markdown={fitHeadings(prose9.markdown)} />
    </div>
  )}
</ComposedPage>
