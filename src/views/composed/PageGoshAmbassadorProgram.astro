---
// Generated by Contentrain Migrate from the plan route `page-gosh-ambassador-program`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import Split from '../../components/kit/split/Split.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageGoshAmbassadorProgram = await getEntry('pageGoshAmbassadorProgram', 'en')
if (!pageGoshAmbassadorProgram) throw new Error('page-gosh-ambassador-program is missing: the page\'s sections are its fields')
const { split, page_contents: pageContents, page_contents_more: pageContentsMore, call_applications_2026: callApplications2026Section, application_process: applicationProcess, diversity_criteria: diversityCriteria, review_process: reviewProcess } = pageGoshAmbassadorProgram.data
const splitActions = (split?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const splitVideoUrl = publicHref(split?.video_url)
const pageContentsActions = (pageContents?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const pageContentsItems = (pageContents?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above1 = !!(split && (!!split?.heading?.trim() || !!split?.body || (split?.features?.length ?? 0) > 0)) || !!(pageContents && (!!pageContents?.heading?.trim() || (pageContents?.items?.length ?? 0) > 0))
const prose0 = headingLevels(pageContentsMore?.markdown, h2Above1 ? 2 : 1)
const callApplications2026SectionHtml = await publicHtml(callApplications2026Section?.html)
const h2Above3 = h2Above1 || prose0.top !== undefined
const prose2 = headingLevels(callApplications2026Section?.markdown, h2Above3 ? 2 : 1)
const applicationProcessHtml = await publicHtml(applicationProcess?.html)
const h2Above5 = h2Above3 || prose2.top !== undefined
const prose4 = headingLevels(applicationProcess?.markdown, h2Above5 ? 2 : 1)
const diversityCriteriaHtml = await publicHtml(diversityCriteria?.html)
const h2Above7 = h2Above5 || prose4.top !== undefined
const prose6 = headingLevels(diversityCriteria?.markdown, h2Above7 ? 2 : 1)
const reviewProcessHtml = await publicHtml(reviewProcess?.html)
const h2Above9 = h2Above7 || prose6.top !== undefined
const prose8 = headingLevels(reviewProcess?.markdown, h2Above9 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {split && (
    <Split
      actions={splitActions}
      body={split.body}
      eyebrow={split.eyebrow}
      features={split.features}
      heading={split.heading}
      image={split.image}
      videoUrl={splitVideoUrl}
      playLabel={t('embed.play')}
      entry="split"
    />
  )}
  {pageContents && (
    <Band
      actions={pageContentsActions}
      eyebrow={pageContents.eyebrow}
      heading={pageContents.heading}
      items={pageContentsItems}
      lead={pageContents.lead}
      media={pageContents.media}
      entry="page_contents"
    />
  )}
  {pageContentsMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {callApplications2026Section && (
    <div id={"Expectations_of_ambassadors"} class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose html={callApplications2026SectionHtml} markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
  {applicationProcess && (
    <div id={"Application_process"} class="container-prose py-8" data-cr-fit data-cr-shift={prose4.shift}>
      <span id={"Selection_Criteria"}></span><Prose html={applicationProcessHtml} markdown={fitHeadings(prose4.markdown)} />
    </div>
  )}
  {diversityCriteria && (
    <div id={"Diversity_Criteria"} class="container-prose py-8" data-cr-fit data-cr-shift={prose6.shift}>
      <Prose html={diversityCriteriaHtml} markdown={fitHeadings(prose6.markdown)} />
    </div>
  )}
  {reviewProcess && (
    <div id={"Review_Process"} class="container-prose py-8" data-cr-fit data-cr-shift={prose8.shift}>
      <span id={"Nominate_someone_to_apply"}></span><span id={"Contact_the_Ambassador_Program_WG"}></span><Prose html={reviewProcessHtml} markdown={fitHeadings(prose8.markdown)} />
    </div>
  )}
</ComposedPage>
