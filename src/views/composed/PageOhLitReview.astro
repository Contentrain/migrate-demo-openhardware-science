---
// Generated by Contentrain Migrate from the plan route `page-oh-lit-review`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import Steps from '../../components/kit/steps/Steps.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageOhLitReview = await getEntry('pageOhLitReview', 'en')
if (!pageOhLitReview) throw new Error('page-oh-lit-review is missing: the page\'s sections are its fields')
const { section, section_more: sectionMore, text, schedule_calls: scheduleCalls, schedule_calls_more: scheduleCallsMore, schedule_calls_note: scheduleCallsNote } = pageOhLitReview.data
const sectionActions = (section?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const sectionItems = (section?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above1 = !!(section && (!!section?.heading?.trim() || (section?.items?.length ?? 0) > 0))
const prose0 = headingLevels(sectionMore?.markdown, h2Above1 ? 2 : 1)
const textHtml = await publicHtml(text?.html)
const h2Above3 = h2Above1 || prose0.top !== undefined
const prose2 = headingLevels(text?.markdown, h2Above3 ? 2 : 1)
const scheduleCallsItems = (scheduleCalls?.items ?? []).map(item => ({ current: item.current, date: item.date, image: item.image, imageAlt: item.image_alt, number: item.number, text: item.text, title: item.title }))
const h2Above5 = h2Above3 || prose2.top !== undefined
const words4 = headingLevels([scheduleCalls?.heading?.trim() ? `## ${scheduleCalls.heading.trim()}` : undefined, scheduleCalls?.intro].filter(Boolean).join('\n\n'), h2Above5 ? 2 : 1)
const h2Above7 = h2Above5 || (scheduleCalls && (scheduleCallsItems?.length ?? 0) > 0 ? (!!scheduleCalls?.heading?.trim() || (scheduleCalls?.items?.length ?? 0) > 0) : words4.top !== undefined)
const prose6 = headingLevels(scheduleCallsMore?.markdown, h2Above7 ? 2 : 1)
const scheduleCallsNoteHtml = await publicHtml(scheduleCallsNote?.html)
const h2Above9 = h2Above7 || prose6.top !== undefined
const prose8 = headingLevels(scheduleCallsNote?.markdown, h2Above9 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {section && (
    <Band
      actions={sectionActions}
      eyebrow={section.eyebrow}
      heading={section.heading}
      items={sectionItems}
      lead={section.lead}
      media={section.media}
      entry="section"
    />
  )}
  {sectionMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
  {scheduleCalls && (scheduleCallsItems?.length ?? 0) > 0 ? (
    <Steps
      heading={scheduleCalls.heading}
      intro={scheduleCalls.intro}
      items={scheduleCallsItems}
      entry="schedule_calls"
    />
  ) : words4.markdown && (
    <div class="container-prose py-8" data-cr-shift={words4.shift}>
      <Prose markdown={words4.markdown} />
    </div>
  )}
  {scheduleCallsMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose6.shift}>
      <Prose markdown={fitHeadings(prose6.markdown)} />
    </div>
  )}
  {scheduleCallsNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose8.shift}>
      <Prose html={scheduleCallsNoteHtml} markdown={fitHeadings(prose8.markdown)} />
    </div>
  )}
</ComposedPage>
