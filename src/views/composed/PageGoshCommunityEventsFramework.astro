---
// Generated by Contentrain Migrate from the plan route `page-gosh-community-events-framework`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Embed from '../../components/kit/embed/Embed.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageGoshCommunityEventsFramework = await getEntry('pageGoshCommunityEventsFramework', 'en')
if (!pageGoshCommunityEventsFramework) throw new Error('page-gosh-community-events-framework is missing: the page\'s sections are its fields')
const { section, section_more: sectionMore, building_up_gosh: buildingUpGosh, what_next: whatNext, embed } = pageGoshCommunityEventsFramework.data
const sectionActions = (section?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const sectionItems = (section?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above1 = !!(section && (!!section?.heading?.trim() || (section?.items?.length ?? 0) > 0))
const prose0 = headingLevels(sectionMore?.markdown, h2Above1 ? 2 : 1)
const buildingUpGoshHtml = await publicHtml(buildingUpGosh?.html)
const h2Above3 = h2Above1 || prose0.top !== undefined
const prose2 = headingLevels(buildingUpGosh?.markdown, h2Above3 ? 2 : 1)
const whatNextHtml = await publicHtml(whatNext?.html)
const h2Above5 = h2Above3 || prose2.top !== undefined
const prose4 = headingLevels(whatNext?.markdown, h2Above5 ? 2 : 1)
const embedUrl = publicHref(embed?.url)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {section && (
    <Band
      actions={sectionActions}
      eyebrow={section.eyebrow}
      heading={section.heading}
      items={sectionItems}
      lead={section.lead}
      media={section.media}
      entry="section"
    />
  )}
  {sectionMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {buildingUpGosh && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose html={buildingUpGoshHtml} markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
  {whatNext && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose4.shift}>
      <Prose html={whatNextHtml} markdown={fitHeadings(prose4.markdown)} />
    </div>
  )}
  {embed && (
    <Embed
      address={embed.address}
      caption={embed.caption}
      playLabel={t('embed.play')}
      poster={embed.poster}
      showLabel={t('embed.show')}
      title={embed.title}
      uploaded={embed.uploaded}
      url={embedUrl}
    />
  )}
</ComposedPage>
