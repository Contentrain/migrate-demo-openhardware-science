---
// Generated by Contentrain Migrate from the plan route `page-5152-2`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Prose from '../../components/kit/prose/Prose.astro'
import Slider from '../../components/kit/slider/Slider.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const page51522Section = await getEntry('page51522', 'en')
if (!page51522Section) throw new Error('page-5152-2 is missing: the page\'s sections are its fields')
const { thank_you_donation: thankYouDonation, thank_you_donation_more: thankYouDonationMore, text } = page51522Section.data
const thankYouDonationActions = (thankYouDonation?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const thankYouDonationSlides = (thankYouDonation?.slides ?? []).map(item => ({ ctaHref: publicHref(item.cta_href), ctaLabel: item.cta_label, embed: publicHref(item.embed), image: item.image, imageAlt: item.image_alt, text: item.text, title: item.title, video: item.video }))
const words0 = headingLevels([thankYouDonation?.heading?.trim() ? `## ${thankYouDonation.heading.trim()}` : undefined, thankYouDonation?.eyebrow, thankYouDonation?.intro].filter(Boolean).join('\n\n'), 1)
const h2Above2 = (thankYouDonation && (thankYouDonationSlides?.length ?? 0) > 0 ? ((thankYouDonation?.slides?.length ?? 0) > 0 || !!thankYouDonation?.heading?.trim()) : words0.top !== undefined)
const prose1 = headingLevels(thankYouDonationMore?.markdown, h2Above2 ? 2 : 1)
const textHtml = await publicHtml(text?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined
const prose3 = headingLevels(text?.markdown, h2Above4 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {thankYouDonation && (thankYouDonationSlides?.length ?? 0) > 0 ? (
    <Slider
      actions={thankYouDonationActions}
      eyebrow={thankYouDonation.eyebrow}
      heading={thankYouDonation.heading}
      intro={thankYouDonation.intro}
      slides={thankYouDonationSlides}
      prevLabel={t('slider.prev')}
      nextLabel={t('slider.next')}
      slideLabel={t('slider.slide')}
      ofLabel={t('slider.of')}
      playLabel={t('embed.play')}
      label={t('slider.label')}
      entry="thank_you_donation"
    />
  ) : words0.markdown && (
    <div class="container-prose py-8" data-cr-shift={words0.shift}>
      <Prose markdown={words0.markdown} />
    </div>
  )}
  {thankYouDonationMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
</ComposedPage>
