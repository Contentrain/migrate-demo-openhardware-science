---
// Generated by Contentrain Migrate from the plan route `page-gosh-code-of-conduct`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageGoshCodeOfConduct = await getEntry('pageGoshCodeOfConduct', 'en')
if (!pageGoshCodeOfConduct) throw new Error('page-gosh-code-of-conduct is missing: the page\'s sections are its fields')
const { section, section_more: sectionMore, page_contents: pageContents, page_contents_more: pageContentsMore, gosh_code_conduct: goshCodeConduct, attending_gosh_events: attendingGoshEvents, gosh_community_forum: goshCommunityForum } = pageGoshCodeOfConduct.data
const sectionActions = (section?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const sectionItems = (section?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above1 = !!(section && (!!section?.heading?.trim() || (section?.items?.length ?? 0) > 0))
const prose0 = headingLevels(sectionMore?.markdown, h2Above1 ? 2 : 1)
const pageContentsActions = (pageContents?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const pageContentsItems = (pageContents?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above3 = h2Above1 || prose0.top !== undefined || !!(pageContents && (!!pageContents?.heading?.trim() || (pageContents?.items?.length ?? 0) > 0))
const prose2 = headingLevels(pageContentsMore?.markdown, h2Above3 ? 2 : 1)
const goshCodeConductHtml = await publicHtml(goshCodeConduct?.html)
const h2Above5 = h2Above3 || prose2.top !== undefined
const prose4 = headingLevels(goshCodeConduct?.markdown, h2Above5 ? 2 : 1)
const attendingGoshEventsHtml = await publicHtml(attendingGoshEvents?.html)
const h2Above7 = h2Above5 || prose4.top !== undefined
const prose6 = headingLevels(attendingGoshEvents?.markdown, h2Above7 ? 2 : 1)
const goshCommunityForumHtml = await publicHtml(goshCommunityForum?.html)
const h2Above9 = h2Above7 || prose6.top !== undefined
const prose8 = headingLevels(goshCommunityForum?.markdown, h2Above9 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {section && (
    <Band
      actions={sectionActions}
      eyebrow={section.eyebrow}
      heading={section.heading}
      items={sectionItems}
      lead={section.lead}
      media={section.media}
      entry="section"
    />
  )}
  {sectionMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {pageContents && (
    <Band
      actions={pageContentsActions}
      eyebrow={pageContents.eyebrow}
      heading={pageContents.heading}
      items={pageContentsItems}
      lead={pageContents.lead}
      media={pageContents.media}
      entry="page_contents"
    />
  )}
  {pageContentsMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
  {goshCodeConduct && (
    <div id={"GOSH_Code_of_Conduct"} class="container-prose py-8" data-cr-fit data-cr-shift={prose4.shift}>
      <span id={"How_To_Report_A_Problem"}></span><span id={"How_It_Works"}></span><span id={"Examples_of_in-person_community_behavior"}></span><span id={"Additional_guidelines_for_online_community_behavior"}></span><span id={"Media_Consent"}></span><span id={"Consequences"}></span><Prose html={goshCodeConductHtml} markdown={fitHeadings(prose4.markdown)} />
    </div>
  )}
  {attendingGoshEvents && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose6.shift}>
      <Prose html={attendingGoshEventsHtml} markdown={fitHeadings(prose6.markdown)} />
    </div>
  )}
  {goshCommunityForum && (
    <div id={"GOSH_Community_Forum_Moderation_Procedure"} class="container-prose py-8" data-cr-fit data-cr-shift={prose8.shift}>
      <span id={"1_Overview"}></span><span id={"2_Terminology"}></span><span id={"3_The_Moderators_Group"}></span><span id={"4_Reporting_Code_of_Conduct_Violations"}></span><span id={"5_Incident_Response_Procedure"}></span><span id={"6_Acknowledgments"}></span><Prose html={goshCommunityForumHtml} markdown={fitHeadings(prose8.markdown)} />
    </div>
  )}
</ComposedPage>
