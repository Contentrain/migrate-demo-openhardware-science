---
// Generated by Contentrain Migrate from the plan route `page-budget`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import CardGrid from '../../components/kit/card-grid/CardGrid.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageBudget = await getEntry('pageBudget', 'en')
if (!pageBudget) throw new Error('page-budget is missing: the page\'s sections are its fields')
const { text, sponsors, sponsors_more: sponsorsMore } = pageBudget.data
const textHtml = await publicHtml(text?.html)
const prose0 = headingLevels(text?.markdown, 1)
const sponsorsItems = (sponsors?.items ?? []).map(item => ({ eyebrow: item.eyebrow, href: publicHref(item.href), icon: item.icon, image: item.image, imageAlt: item.image_alt, linkLabel: item.link_label, text: item.text, title: item.title }))
const h2Above2 = prose0.top !== undefined
const words1 = headingLevels([sponsors?.title?.trim() ? `## ${sponsors.title.trim()}` : undefined, sponsors?.intro].filter(Boolean).join('\n\n'), h2Above2 ? 2 : 1)
const h2Above4 = h2Above2 || (sponsors && (sponsorsItems?.length ?? 0) > 0 ? (!!sponsors?.title?.trim() || (sponsors?.items?.length ?? 0) > 0) : words1.top !== undefined)
const prose3 = headingLevels(sponsorsMore?.markdown, h2Above4 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {sponsors && (sponsorsItems?.length ?? 0) > 0 ? (
    <CardGrid
      intro={sponsors.intro}
      items={sponsorsItems}
      title={sponsors.title}
      columns="3"
      entry="sponsors"
    />
  ) : words1.markdown && (
    <div class="container-prose py-8" data-cr-shift={words1.shift}>
      <Prose markdown={words1.markdown} />
    </div>
  )}
  {sponsorsMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
</ComposedPage>
