---
// Generated by Contentrain Migrate from the plan route `page-governance-structure`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Prose from '../../components/kit/prose/Prose.astro'
import Split from '../../components/kit/split/Split.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageGovernanceStructure = await getEntry('pageGovernanceStructure', 'en')
if (!pageGovernanceStructure) throw new Error('page-governance-structure is missing: the page\'s sections are its fields')
const { community, community_council: communityCouncil } = pageGovernanceStructure.data
const communityActions = (community?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const communityVideoUrl = publicHref(community?.video_url)
const communityCouncilHtml = await publicHtml(communityCouncil?.html)
const h2Above1 = !!(community && (!!community?.heading?.trim() || !!community?.body || (community?.features?.length ?? 0) > 0))
const prose0 = headingLevels(communityCouncil?.markdown, h2Above1 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {community && (
    <Split
      actions={communityActions}
      body={community.body}
      eyebrow={community.eyebrow}
      features={community.features}
      heading={community.heading}
      image={community.image}
      videoUrl={communityVideoUrl}
      playLabel={t('embed.play')}
      imageSide="start"
      entry="community"
    />
  )}
  {communityCouncil && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={communityCouncilHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
</ComposedPage>
