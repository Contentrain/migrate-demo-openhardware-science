---
// Generated by Contentrain Migrate from the plan route `page-2022-gosh-community-council-election`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const page2022GoshCommunityCouncilElection = await getEntry('page2022GoshCommunityCouncilElection', 'en')
if (!page2022GoshCommunityCouncilElection) throw new Error('page-2022-gosh-community-council-election is missing: the page\'s sections are its fields')
const { text, text_note: textNote, how_do_i: howDoI, how_do_i_text: howDoIText, nominations } = page2022GoshCommunityCouncilElection.data
const textHtml = await publicHtml(text?.html)
const prose0 = headingLevels(text?.markdown, 1)
const textNoteHtml = await publicHtml(textNote?.html)
const h2Above2 = prose0.top !== undefined
const prose1 = headingLevels(textNote?.markdown, h2Above2 ? 2 : 1)
const howDoIHtml = await publicHtml(howDoI?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined
const prose3 = headingLevels(howDoI?.markdown, h2Above4 ? 2 : 1)
const howDoITextHtml = await publicHtml(howDoIText?.html)
const h2Above6 = h2Above4 || prose3.top !== undefined
const prose5 = headingLevels(howDoIText?.markdown, h2Above6 ? 2 : 1)
const nominationsHtml = await publicHtml(nominations?.html)
const h2Above8 = h2Above6 || prose5.top !== undefined
const prose7 = headingLevels(nominations?.markdown, h2Above8 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {textNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose html={textNoteHtml} markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {howDoI && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose html={howDoIHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
  {howDoIText && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose5.shift}>
      <Prose html={howDoITextHtml} markdown={fitHeadings(prose5.markdown)} />
    </div>
  )}
  {nominations && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose7.shift}>
      <Prose html={nominationsHtml} markdown={fitHeadings(prose7.markdown)} />
    </div>
  )}
</ComposedPage>
