---
// Generated by Contentrain Migrate from the plan route `page-apply`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import PostList from '../../components/kit/post-list/PostList.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { byId, getPosts, getSite, imageOf, postHref, termHref, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml } from '../../lib/links'
import type { ListPage } from '../../lib/site-routes'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
  list?: ListPage | undefined
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail, list } = Astro.props
const isHome = false
const site = await getSite()
const pageApply = await getEntry('pageApply', 'en')
if (!pageApply) throw new Error('page-apply is missing: the page\'s sections are its fields')
const { text } = pageApply.data
const entries0 = (list?.posts ?? await getPosts()).slice(0, 1)
const items3 = await Promise.all(entries0.map(async item => {
  const media1 = (item.data.cover ? await getEntry(item.data.cover) : undefined)
  const term2 = (item.data.categories[0] ? await getEntry(item.data.categories[0]) : undefined)
  return {
    title: item.data.title,
    href: postHref(item, await byId('categories')),
    excerpt: item.data.excerpt,
    date: item.data.published_at,
    image: (media1 ? imageOf(media1) : undefined),
    author: (item.data.author ? await getEntry(item.data.author) : undefined)?.data.name,
    category: (term2 ? { label: term2.data.name, href: termHref('category', term2, await byId('categories')) } : undefined),
  }
}))
const section0 = items3?.length ? {
  layout: 'list' as const,
  locale: site.language,
  posts: items3,
} : undefined
const textHtml = await publicHtml(text?.html)
const h2Above5 = (section0?.posts?.length ?? 0) > 0
const prose4 = headingLevels(text?.markdown, h2Above5 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {section0 && <PostList {...section0} />}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose4.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose4.markdown)} />
    </div>
  )}
</ComposedPage>
