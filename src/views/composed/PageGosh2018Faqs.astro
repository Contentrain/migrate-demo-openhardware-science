---
// Generated by Contentrain Migrate from the plan route `page-gosh-2018-faqs`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Faq from '../../components/kit/faq/Faq.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const pageGosh2018Faqs = await getEntry('pageGosh2018Faqs', 'en')
if (!pageGosh2018Faqs) throw new Error('page-gosh-2018-faqs is missing: the page\'s sections are its fields')
const { text, faq, faq_note: faqNote } = pageGosh2018Faqs.data
const textHtml = await publicHtml(text?.html)
const prose0 = headingLevels(text?.markdown, 1)
const faqItems = await Promise.all((faq?.items ?? []).map(async item => ({ answer: await publicHtml(item.answer), question: item.question })))
const h2Above2 = prose0.top !== undefined
const words1 = headingLevels([faq?.heading?.trim() ? `## ${faq.heading.trim()}` : undefined, faq?.intro].filter(Boolean).join('\n\n'), h2Above2 ? 2 : 1)
const faqNoteHtml = await publicHtml(faqNote?.html)
const h2Above4 = h2Above2 || (faq && (faqItems?.length ?? 0) > 0 ? (!!faq?.heading?.trim()) : words1.top !== undefined)
const prose3 = headingLevels(faqNote?.markdown, h2Above4 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {faq && (faqItems?.length ?? 0) > 0 ? (
    <Faq
      heading={faq.heading}
      intro={faq.intro}
      items={faqItems}
      columns="2"
      entry="faq"
    />
  ) : words1.markdown && (
    <div class="container-prose py-8" data-cr-shift={words1.shift}>
      <Prose markdown={words1.markdown} />
    </div>
  )}
  {faqNote && (
    <div id={"Event_Timing"} class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <span id={"Getting_to_Shenzhen_and_travel_funding"}></span><span id={"Accommodation"}></span><span id={"Programming_and_Participants"}></span><span id={"Wifi"}></span><span id={"People_and_Contacts"}></span><Prose html={faqNoteHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
</ComposedPage>
