const h2Above4 = h2Above2 || prose1.top !== undefined || !!(ctaBand && (!!ctaBand?.heading?.trim() || (ctaBand?.items?.length ?? 0) > 0))
const words3 = headingLevels([logoCloud?.heading?.trim() ? `## ${logoCloud.heading.trim()}` : undefined].filter(Boolean).join('\n\n'), h2Above4 ? 2 : 1)
