const h2Above10 = h2Above8 || prose7.top !== undefined
const prose9 = headingLevels(whatWillHappen?.markdown, h2Above10 ? 2 : 1)
const supportGoshActions = (supportGosh?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const supportGoshImage = supportGosh?.image ? { src: supportGosh.image } : undefined
const h2Above12 = h2Above10 || prose9.top !== undefined
const words11 = headingLevels([supportGosh?.heading?.trim() ? `## ${supportGosh.heading.trim()}` : undefined, supportGosh?.body, supportGosh?.eyebrow, supportGosh?.note].filter(Boolean).join('\n\n'), h2Above12 ? 2 : 1)
const goshCodeConductActions = (goshCodeConduct?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const goshCodeConductImage = goshCodeConduct?.image ? { src: goshCodeConduct.image } : undefined
