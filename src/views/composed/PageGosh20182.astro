const words13 = headingLevels([goshCodeConduct?.heading?.trim() ? `## ${goshCodeConduct.heading.trim()}` : undefined, goshCodeConduct?.body, goshCodeConduct?.eyebrow, goshCodeConduct?.note].filter(Boolean).join('\n\n'), h2Above14 ? 2 : 1)
const h2Above16 = h2Above14 || (goshCodeConduct && goshCodeConduct.heading !== undefined && (goshCodeConductActions?.length ?? 0) > 0 ? (!!goshCodeConduct?.heading?.trim()) : words13.top !== undefined)
const prose15 = headingLevels(goshCodeConductMore?.markdown, h2Above16 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {hero && hero.heading !== undefined ? (
    <div class="contents" data-cr-hero style={headingFit(hero.heading)} data-cr-split>
      <Hero
        actions={heroActions}
        eyebrow={hero.eyebrow}
        heading={hero.heading}
        image={hero.image}
        items={hero.items}
        lead={hero.lead}
        level={2}
        entry="hero"
      />
    </div>
  ) : words0.markdown && (
    <div class="container-prose py-8" data-cr-shift={words0.shift}>
      <Prose markdown={words0.markdown} />
    </div>
  )}
  {heroMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {ctaBand && (
    <Band
      actions={ctaBandActions}
      eyebrow={ctaBand.eyebrow}
      heading={ctaBand.heading}
      items={ctaBandItems}
      lead={ctaBand.lead}
      media={ctaBand.media}
      entry="cta_band"
    />
  )}
  {logoCloud && (logoCloudItems?.length ?? 0) > 0 ? (
    <LogoCloud
      heading={logoCloud.heading}
      items={logoCloudItems}
