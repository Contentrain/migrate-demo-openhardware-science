    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose7.shift}>
      <Prose html={advocatesHtml} markdown={fitHeadings(prose7.markdown)} />
    </div>
  )}
  {whatWillHappen && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose9.shift}>
      <Prose html={whatWillHappenHtml} markdown={fitHeadings(prose9.markdown)} />
    </div>
  )}
  {supportGosh && supportGosh.heading !== undefined && (supportGoshActions?.length ?? 0) > 0 ? (
    <Cta
      actions={supportGoshActions}
      bgImage={supportGosh.bg_image}
      body={supportGosh.body}
      eyebrow={supportGosh.eyebrow}
      heading={supportGosh.heading}
      image={supportGoshImage}
      note={supportGosh.note}
      entry="support_gosh"
    />
  ) : words11.markdown && (
    <div class="container-prose py-8" data-cr-shift={words11.shift}>
      <Prose markdown={words11.markdown} />
