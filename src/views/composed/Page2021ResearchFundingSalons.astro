---
// Generated by Contentrain Migrate from the plan route `page-2021-research-funding-salons`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Behavior from '../../components/kit/behavior/Behavior.astro'
import Faq from '../../components/kit/faq/Faq.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const page2021ResearchFundingSalons = await getEntry('page2021ResearchFundingSalons', 'en')
if (!page2021ResearchFundingSalons) throw new Error('page-2021-research-funding-salons is missing: the page\'s sections are its fields')
const { about, text, faq, faq_more: faqMore, faq_note: faqNote, behavior, behavior_2: behavior2Section, behavior_3: behavior3Section, behavior_4: behavior4Section, behavior_5: behavior5Section } = page2021ResearchFundingSalons.data
const aboutHtml = await publicHtml(about?.html)
const prose0 = headingLevels(about?.markdown, 1)
const textHtml = await publicHtml(text?.html)
const h2Above2 = prose0.top !== undefined
const prose1 = headingLevels(text?.markdown, h2Above2 ? 2 : 1)
const faqItems = await Promise.all((faq?.items ?? []).map(async item => ({ answer: await publicHtml(item.answer), question: item.question })))
const h2Above4 = h2Above2 || prose1.top !== undefined
const words3 = headingLevels([faq?.heading?.trim() ? `## ${faq.heading.trim()}` : undefined, faq?.intro].filter(Boolean).join('\n\n'), h2Above4 ? 2 : 1)
const h2Above6 = h2Above4 || (faq && (faqItems?.length ?? 0) > 0 ? (!!faq?.heading?.trim()) : words3.top !== undefined)
const prose5 = headingLevels(faqMore?.markdown, h2Above6 ? 2 : 1)
const faqNoteHtml = await publicHtml(faqNote?.html)
const h2Above8 = h2Above6 || prose5.top !== undefined
const prose7 = headingLevels(faqNote?.markdown, h2Above8 ? 2 : 1)
const behaviorHtml = await publicHtml(behavior?.html)
const behavior2SectionHtml = await publicHtml(behavior2Section?.html)
const behavior3SectionHtml = await publicHtml(behavior3Section?.html)
const behavior4SectionHtml = await publicHtml(behavior4Section?.html)
const behavior5SectionHtml = await publicHtml(behavior5Section?.html)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {about && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={aboutHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {faq && (faqItems?.length ?? 0) > 0 ? (
    <Faq
      heading={faq.heading}
      intro={faq.intro}
      items={faqItems}
      columns="2"
      entry="faq"
    />
  ) : words3.markdown && (
    <div class="container-prose py-8" data-cr-shift={words3.shift}>
      <Prose markdown={words3.markdown} />
    </div>
  )}
  {faqMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose5.shift}>
      <Prose markdown={fitHeadings(prose5.markdown)} />
    </div>
  )}
  {faqNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose7.shift}>
      <Prose html={faqNoteHtml} markdown={fitHeadings(prose7.markdown)} />
    </div>
  )}
  {behavior && behavior?.island?.kind !== undefined && (
    <Behavior
      html={behaviorHtml}
      kind={behavior?.island?.kind}
      fact={behavior?.island?.fact}
      items={behavior?.island?.items}
      title={behavior?.island?.title}
      panel={behavior?.island?.panel}
      previousLabel={t('slider.prev')}
      nextLabel={t('slider.next')}
      closeLabel={t('dialog.close')}
      entry="behavior"
    />
  )}
  {behavior2Section && behavior2Section?.island?.kind !== undefined && (
    <Behavior
      html={behavior2SectionHtml}
      kind={behavior2Section?.island?.kind}
      fact={behavior2Section?.island?.fact}
      items={behavior2Section?.island?.items}
      title={behavior2Section?.island?.title}
      panel={behavior2Section?.island?.panel}
      previousLabel={t('slider.prev')}
      nextLabel={t('slider.next')}
      closeLabel={t('dialog.close')}
      entry="behavior_2"
    />
  )}
  {behavior3Section && behavior3Section?.island?.kind !== undefined && (
    <Behavior
      html={behavior3SectionHtml}
      kind={behavior3Section?.island?.kind}
      fact={behavior3Section?.island?.fact}
      items={behavior3Section?.island?.items}
      title={behavior3Section?.island?.title}
      panel={behavior3Section?.island?.panel}
      previousLabel={t('slider.prev')}
      nextLabel={t('slider.next')}
      closeLabel={t('dialog.close')}
      entry="behavior_3"
    />
  )}
  {behavior4Section && behavior4Section?.island?.kind !== undefined && (
    <Behavior
      html={behavior4SectionHtml}
      kind={behavior4Section?.island?.kind}
      fact={behavior4Section?.island?.fact}
      items={behavior4Section?.island?.items}
      title={behavior4Section?.island?.title}
      panel={behavior4Section?.island?.panel}
      previousLabel={t('slider.prev')}
      nextLabel={t('slider.next')}
      closeLabel={t('dialog.close')}
      entry="behavior_4"
    />
  )}
  {behavior5Section && behavior5Section?.island?.kind !== undefined && (
    <Behavior
      html={behavior5SectionHtml}
      kind={behavior5Section?.island?.kind}
      fact={behavior5Section?.island?.fact}
      items={behavior5Section?.island?.items}
      title={behavior5Section?.island?.title}
      panel={behavior5Section?.island?.panel}
      previousLabel={t('slider.prev')}
      nextLabel={t('slider.next')}
      closeLabel={t('dialog.close')}
      entry="behavior_5"
    />
  )}
</ComposedPage>
