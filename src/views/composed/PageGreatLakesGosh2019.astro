import LogoCloud from '../../components/kit/logo-cloud/LogoCloud.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { headingFit } from '../../lib/heading-fit'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageGreatLakesGosh2019Section = await getEntry('pageGreatLakesGosh2019', 'en')
if (!pageGreatLakesGosh2019Section) throw new Error('page-great-lakes-gosh-2019 is missing: the page\'s sections are its fields')
const { hero, hero_more: heroMore, join_community: joinCommunity, supporters, logo_cloud: logoCloud, logo_cloud_more: logoCloudMore, gosh_code_conduct: goshCodeConduct, gosh_code_conduct_more: goshCodeConductMore } = pageGreatLakesGosh2019Section.data
const heroActions = (hero?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const words0 = headingLevels([hero?.heading?.trim() ? `## ${hero.heading.trim()}` : undefined, hero?.eyebrow, hero?.lead].filter(Boolean).join('\n\n'), 1)
const h2Above2 = (hero && hero.heading !== undefined ? (!!hero?.heading?.trim() || (hero?.items?.length ?? 0) > 0) : words0.top !== undefined)
const prose1 = headingLevels(heroMore?.markdown, h2Above2 ? 2 : 1)
const joinCommunityHtml = await publicHtml(joinCommunity?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined
const prose3 = headingLevels(joinCommunity?.markdown, h2Above4 ? 2 : 1)
const supportersHtml = await publicHtml(supporters?.html)
const h2Above6 = h2Above4 || prose3.top !== undefined
const prose5 = headingLevels(supporters?.markdown, h2Above6 ? 2 : 1)
const logoCloudItems = (logoCloud?.items ?? []).map(item => ({ href: publicHref(item.href), image: item.image, imageAlt: item.image_alt }))
const h2Above8 = h2Above6 || prose5.top !== undefined
const words7 = headingLevels([logoCloud?.heading?.trim() ? `## ${logoCloud.heading.trim()}` : undefined].filter(Boolean).join('\n\n'), h2Above8 ? 2 : 1)
const h2Above10 = h2Above8 || (logoCloud && (logoCloudItems?.length ?? 0) > 0 ? (!!logoCloud?.heading?.trim()) : words7.top !== undefined)
const prose9 = headingLevels(logoCloudMore?.markdown, h2Above10 ? 2 : 1)
const goshCodeConductActions = (goshCodeConduct?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const goshCodeConductItems = (goshCodeConduct?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above12 = h2Above10 || prose9.top !== undefined || !!(goshCodeConduct && (!!goshCodeConduct?.heading?.trim() || (goshCodeConduct?.items?.length ?? 0) > 0))
const prose11 = headingLevels(goshCodeConductMore?.markdown, h2Above12 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {hero && hero.heading !== undefined ? (
    <div class="contents" data-cr-hero style={headingFit(hero.heading)} data-cr-split>
      <Hero
        actions={heroActions}
        eyebrow={hero.eyebrow}
        heading={hero.heading}
        image={hero.image}
        items={hero.items}
        lead={hero.lead}
        level={2}
        entry="hero"
      />
