    <LogoCloud
      heading={logoCloud.heading}
      items={logoCloudItems}
      columns="4"
      entry="logo_cloud"
    />
  ) : words7.markdown && (
    <div class="container-prose py-8" data-cr-shift={words7.shift}>
      <Prose markdown={words7.markdown} />
