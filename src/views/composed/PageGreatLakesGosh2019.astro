      actions={goshCodeConductActions}
      eyebrow={goshCodeConduct.eyebrow}
      heading={goshCodeConduct.heading}
      items={goshCodeConductItems}
      lead={goshCodeConduct.lead}
      media={goshCodeConduct.media}
      entry="gosh_code_conduct"
    />
  )}
  {goshCodeConductMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose11.shift}>
