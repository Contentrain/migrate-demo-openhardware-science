---
// Generated by Contentrain Migrate from the plan route `page-2018-program`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const page2018Program = await getEntry('page2018Program', 'en')
if (!page2018Program) throw new Error('page-2018-program is missing: the page\'s sections are its fields')
const { pre_gosh: preGosh, day_1_wednesday: day1Wednesday, day_2_thursday: day2Thursday, day_3_friday: day3Friday, day_4_saturday: day4Saturday, post_gosh: postGosh } = page2018Program.data
const preGoshHtml = await publicHtml(preGosh?.html)
const prose0 = headingLevels(preGosh?.markdown, 1)
const day1WednesdayHtml = await publicHtml(day1Wednesday?.html)
const h2Above2 = prose0.top !== undefined
const prose1 = headingLevels(day1Wednesday?.markdown, h2Above2 ? 2 : 1)
const day2ThursdayHtml = await publicHtml(day2Thursday?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined
const prose3 = headingLevels(day2Thursday?.markdown, h2Above4 ? 2 : 1)
const day3FridayHtml = await publicHtml(day3Friday?.html)
const h2Above6 = h2Above4 || prose3.top !== undefined
const prose5 = headingLevels(day3Friday?.markdown, h2Above6 ? 2 : 1)
const day4SaturdayHtml = await publicHtml(day4Saturday?.html)
const h2Above8 = h2Above6 || prose5.top !== undefined
const prose7 = headingLevels(day4Saturday?.markdown, h2Above8 ? 2 : 1)
const postGoshHtml = await publicHtml(postGosh?.html)
const h2Above10 = h2Above8 || prose7.top !== undefined
const prose9 = headingLevels(postGosh?.markdown, h2Above10 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {preGosh && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={preGoshHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {day1Wednesday && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose html={day1WednesdayHtml} markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {day2Thursday && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose html={day2ThursdayHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
  {day3Friday && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose5.shift}>
      <Prose html={day3FridayHtml} markdown={fitHeadings(prose5.markdown)} />
    </div>
  )}
  {day4Saturday && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose7.shift}>
      <Prose html={day4SaturdayHtml} markdown={fitHeadings(prose7.markdown)} />
    </div>
  )}
  {postGosh && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose9.shift}>
      <Prose html={postGoshHtml} markdown={fitHeadings(prose9.markdown)} />
    </div>
  )}
</ComposedPage>
