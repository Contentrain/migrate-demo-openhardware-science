---
// Generated by Contentrain Migrate from the plan route `page-gosh-manifesto`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import ContactForm from '../../components/kit/contact-form/ContactForm.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageGoshManifesto = await getEntry('pageGoshManifesto', 'en')
if (!pageGoshManifesto) throw new Error('page-gosh-manifesto is missing: the page\'s sections are its fields')
const { section, faq, faq_more: faqMore, text, contact_form: contactForm, contact_form_section: contactFormSection, contact_form_note: contactFormNote } = pageGoshManifesto.data
const sectionActions = (section?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const sectionItems = (section?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const faqActions = (faq?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const faqItems = (faq?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above1 = !!(section && (!!section?.heading?.trim() || (section?.items?.length ?? 0) > 0)) || !!(faq && (!!faq?.heading?.trim() || (faq?.items?.length ?? 0) > 0))
const prose0 = headingLevels(faqMore?.markdown, h2Above1 ? 2 : 1)
const textHtml = await publicHtml(text?.html)
const h2Above3 = h2Above1 || prose0.top !== undefined
const prose2 = headingLevels(text?.markdown, h2Above3 ? 2 : 1)
const contactFormDetails = (contactForm?.details ?? []).map(item => ({ href: publicHref(item.href), iconImage: item.icon_image, label: item.label, value: item.value }))
const contactFormMap = contactForm?.map && { address: contactForm?.map.address, title: contactForm?.map.title, url: publicHref(contactForm?.map.url) }
const contactFormSocials = (contactForm?.socials ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label }] })
const contactFormSectionActions = (contactFormSection?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const contactFormSectionItems = (contactFormSection?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const contactFormNoteHtml = await publicHtml(contactFormNote?.html)
const h2Above5 = h2Above3 || prose2.top !== undefined || !!contactForm?.heading?.trim() || !!(contactFormSection && (!!contactFormSection?.heading?.trim() || (contactFormSection?.items?.length ?? 0) > 0))
const prose4 = headingLevels(contactFormNote?.markdown, h2Above5 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {section && (
    <Band
      actions={sectionActions}
      eyebrow={section.eyebrow}
      heading={section.heading}
      items={sectionItems}
      lead={section.lead}
      media={section.media}
      entry="section"
    />
  )}
  {faq && (
    <Band
      actions={faqActions}
      eyebrow={faq.eyebrow}
      heading={faq.heading}
      items={faqItems}
      lead={faq.lead}
      media={faq.media}
      columns="4"
      entry="faq"
    />
  )}
  {faqMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
  <ContactForm
    details={contactFormDetails}
    formHeading={contactForm?.form_heading}
    heading={contactForm?.heading}
    hours={contactForm?.hours}
    intro={contactForm?.intro}
    map={contactFormMap}
    socials={contactFormSocials}
    model="contact-gosh-manifesto"
    entry="contact_form"
  />
  {contactFormSection && (
    <Band
      actions={contactFormSectionActions}
      eyebrow={contactFormSection.eyebrow}
      heading={contactFormSection.heading}
      items={contactFormSectionItems}
      lead={contactFormSection.lead}
      media={contactFormSection.media}
      entry="contact_form_section"
    />
  )}
  {contactFormNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose4.shift}>
      <Prose html={contactFormNoteHtml} markdown={fitHeadings(prose4.markdown)} />
    </div>
  )}
</ComposedPage>
