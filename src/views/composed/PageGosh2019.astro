---
// Generated by Contentrain Migrate from the plan route `page-gosh2019`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import Steps from '../../components/kit/steps/Steps.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageGosh2019Section = await getEntry('pageGosh2019', 'en')
if (!pageGosh2019Section) throw new Error('page-gosh2019 is missing: the page\'s sections are its fields')
const { hero, steps, steps_more: stepsMore } = pageGosh2019Section.data
const heroActions = (hero?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const heroItems = (hero?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const stepsItems = (steps?.items ?? []).map(item => ({ current: item.current, date: item.date, image: item.image, imageAlt: item.image_alt, number: item.number, text: item.text, title: item.title }))
const h2Above1 = !!(hero && (!!hero?.heading?.trim() || (hero?.items?.length ?? 0) > 0))
const words0 = headingLevels([steps?.heading?.trim() ? `## ${steps.heading.trim()}` : undefined, steps?.intro].filter(Boolean).join('\n\n'), h2Above1 ? 2 : 1)
const h2Above3 = h2Above1 || (steps && (stepsItems?.length ?? 0) > 0 ? (!!steps?.heading?.trim() || (steps?.items?.length ?? 0) > 0) : words0.top !== undefined)
const prose2 = headingLevels(stepsMore?.markdown, h2Above3 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {hero && (
    <Band
      actions={heroActions}
      eyebrow={hero.eyebrow}
      heading={hero.heading}
      items={heroItems}
      lead={hero.lead}
      media={hero.media}
      entry="hero"
    />
  )}
  {steps && (stepsItems?.length ?? 0) > 0 ? (
    <Steps
      heading={steps.heading}
      intro={steps.intro}
      items={stepsItems}
      entry="steps"
    />
  ) : words0.markdown && (
    <div class="container-prose py-8" data-cr-shift={words0.shift}>
      <Prose markdown={words0.markdown} />
    </div>
  )}
  {stepsMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
</ComposedPage>
