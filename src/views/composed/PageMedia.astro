---
// Generated by Contentrain Migrate from the plan route `page-media`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const pageMedia = await getEntry('pageMedia', 'en')
if (!pageMedia) throw new Error('page-media is missing: the page\'s sections are its fields')
const { links_write_ups: linksWriteUps, information_media_press: informationMediaPress, press_information: pressInformation } = pageMedia.data
const linksWriteUpsHtml = await publicHtml(linksWriteUps?.html)
const prose0 = headingLevels(linksWriteUps?.markdown, 1)
const informationMediaPressHtml = await publicHtml(informationMediaPress?.html)
const h2Above2 = prose0.top !== undefined
const prose1 = headingLevels(informationMediaPress?.markdown, h2Above2 ? 2 : 1)
const pressInformationHtml = await publicHtml(pressInformation?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined
const prose3 = headingLevels(pressInformation?.markdown, h2Above4 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {linksWriteUps && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={linksWriteUpsHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {informationMediaPress && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose html={informationMediaPressHtml} markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {pressInformation && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose html={pressInformationHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
</ComposedPage>
