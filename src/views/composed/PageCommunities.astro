---
// Generated by Contentrain Migrate from the plan route `page-communities`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import CardGrid from '../../components/kit/card-grid/CardGrid.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageCommunities = await getEntry('pageCommunities', 'en')
if (!pageCommunities) throw new Error('page-communities is missing: the page\'s sections are its fields')
const { card_grid: cardGrid, card_grid_more: cardGridMore } = pageCommunities.data
const cardGridItems = (cardGrid?.items ?? []).map(item => ({ eyebrow: item.eyebrow, href: publicHref(item.href), icon: item.icon, image: item.image, imageAlt: item.image_alt, linkLabel: item.link_label, text: item.text, title: item.title }))
const words0 = headingLevels([cardGrid?.title?.trim() ? `## ${cardGrid.title.trim()}` : undefined, cardGrid?.intro].filter(Boolean).join('\n\n'), 1)
const h2Above2 = (cardGrid && (cardGridItems?.length ?? 0) > 0 ? (!!cardGrid?.title?.trim() || (cardGrid?.items?.length ?? 0) > 0) : words0.top !== undefined)
const prose1 = headingLevels(cardGridMore?.markdown, h2Above2 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {cardGrid && (cardGridItems?.length ?? 0) > 0 ? (
    <CardGrid
      intro={cardGrid.intro}
      items={cardGridItems}
      title={cardGrid.title}
      columns="4"
      entry="card_grid"
    />
  ) : words0.markdown && (
    <div class="container-prose py-8" data-cr-shift={words0.shift}>
      <Prose markdown={words0.markdown} />
    </div>
  )}
  {cardGridMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
</ComposedPage>
