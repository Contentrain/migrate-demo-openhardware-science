---
// Generated by Contentrain Migrate from the plan route `page-logistics`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Embed from '../../components/kit/embed/Embed.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageLogistics = await getEntry('pageLogistics', 'en')
if (!pageLogistics) throw new Error('page-logistics is missing: the page\'s sections are its fields')
const { event_timing: eventTiming, embed, embed_2: embed2Section, embed_3: embed3Section, section, text, text_note: textNote, text_note_i: textNoteI, how_do_i: howDoI, visas, programme_participants: programmeParticipants, people_contacts: peopleContacts, where_we_re: whereWeRe } = pageLogistics.data
const eventTimingHtml = await publicHtml(eventTiming?.html)
const prose0 = headingLevels(eventTiming?.markdown, 1)
const embedUrl = publicHref(embed?.url)
const embed2SectionUrl = publicHref(embed2Section?.url)
const embed3SectionUrl = publicHref(embed3Section?.url)
const sectionActions = (section?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const sectionItems = (section?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const textHtml = await publicHtml(text?.html)
const h2Above2 = prose0.top !== undefined || !!(embed && (!!embed?.title?.trim())) || !!(embed2Section && (!!embed2Section?.title?.trim())) || !!(embed3Section && (!!embed3Section?.title?.trim())) || !!(section && (!!section?.heading?.trim() || (section?.items?.length ?? 0) > 0))
const prose1 = headingLevels(text?.markdown, h2Above2 ? 2 : 1)
const textNoteHtml = await publicHtml(textNote?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined
const prose3 = headingLevels(textNote?.markdown, h2Above4 ? 2 : 1)
const textNoteIHtml = await publicHtml(textNoteI?.html)
const h2Above6 = h2Above4 || prose3.top !== undefined
const prose5 = headingLevels(textNoteI?.markdown, h2Above6 ? 2 : 1)
const howDoIHtml = await publicHtml(howDoI?.html)
const h2Above8 = h2Above6 || prose5.top !== undefined
const prose7 = headingLevels(howDoI?.markdown, h2Above8 ? 2 : 1)
const visasHtml = await publicHtml(visas?.html)
const h2Above10 = h2Above8 || prose7.top !== undefined
const prose9 = headingLevels(visas?.markdown, h2Above10 ? 2 : 1)
const programmeParticipantsHtml = await publicHtml(programmeParticipants?.html)
const h2Above12 = h2Above10 || prose9.top !== undefined
const prose11 = headingLevels(programmeParticipants?.markdown, h2Above12 ? 2 : 1)
const peopleContactsHtml = await publicHtml(peopleContacts?.html)
const h2Above14 = h2Above12 || prose11.top !== undefined
const prose13 = headingLevels(peopleContacts?.markdown, h2Above14 ? 2 : 1)
const whereWeReHtml = await publicHtml(whereWeRe?.html)
const h2Above16 = h2Above14 || prose13.top !== undefined
const prose15 = headingLevels(whereWeRe?.markdown, h2Above16 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {eventTiming && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={eventTimingHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {embed && (
    <Embed
      address={embed.address}
      caption={embed.caption}
      playLabel={t('embed.play')}
      poster={embed.poster}
      showLabel={t('embed.show')}
      title={embed.title}
      uploaded={embed.uploaded}
      url={embedUrl}
      aspect="map"
    />
  )}
  {embed2Section && (
    <Embed
      address={embed2Section.address}
      caption={embed2Section.caption}
      playLabel={t('embed.play')}
      poster={embed2Section.poster}
      showLabel={t('embed.show')}
      title={embed2Section.title}
      uploaded={embed2Section.uploaded}
      url={embed2SectionUrl}
      aspect="map"
    />
  )}
  {embed3Section && (
    <Embed
      address={embed3Section.address}
      caption={embed3Section.caption}
      playLabel={t('embed.play')}
      poster={embed3Section.poster}
      showLabel={t('embed.show')}
      title={embed3Section.title}
      uploaded={embed3Section.uploaded}
      url={embed3SectionUrl}
      aspect="map"
    />
  )}
  {section && (
    <Band
      actions={sectionActions}
      eyebrow={section.eyebrow}
      heading={section.heading}
      items={sectionItems}
      lead={section.lead}
      media={section.media}
      entry="section"
    />
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {textNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose html={textNoteHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
  {textNoteI && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose5.shift}>
      <Prose html={textNoteIHtml} markdown={fitHeadings(prose5.markdown)} />
    </div>
  )}
  {howDoI && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose7.shift}>
      <Prose html={howDoIHtml} markdown={fitHeadings(prose7.markdown)} />
    </div>
  )}
  {visas && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose9.shift}>
      <Prose html={visasHtml} markdown={fitHeadings(prose9.markdown)} />
    </div>
  )}
  {programmeParticipants && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose11.shift}>
      <Prose html={programmeParticipantsHtml} markdown={fitHeadings(prose11.markdown)} />
    </div>
  )}
  {peopleContacts && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose13.shift}>
      <Prose html={peopleContactsHtml} markdown={fitHeadings(prose13.markdown)} />
    </div>
  )}
  {whereWeRe && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose15.shift}>
      <Prose html={whereWeReHtml} markdown={fitHeadings(prose15.markdown)} />
    </div>
  )}
</ComposedPage>
