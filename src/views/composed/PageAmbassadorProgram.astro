---
// Generated by Contentrain Migrate from the plan route `page-ambassador-program`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Prose from '../../components/kit/prose/Prose.astro'
import Split from '../../components/kit/split/Split.astro'
import Team from '../../components/kit/team/Team.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageAmbassadorProgram = await getEntry('pageAmbassadorProgram', 'en')
if (!pageAmbassadorProgram) throw new Error('page-ambassador-program is missing: the page\'s sections are its fields')
const { split, text, team, team_more: teamMore } = pageAmbassadorProgram.data
const splitActions = (split?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const splitVideoUrl = publicHref(split?.video_url)
const textHtml = await publicHtml(text?.html)
const h2Above1 = !!(split && (!!split?.heading?.trim() || !!split?.body || (split?.features?.length ?? 0) > 0))
const prose0 = headingLevels(text?.markdown, h2Above1 ? 2 : 1)
const teamItems = (team?.items ?? []).map(item => ({ bio: item.bio, href: publicHref(item.href), image: item.image, imageAlt: item.image_alt, links: (item.links ?? []).flatMap(url => publicHref(url) ?? []), name: item.name, role: item.role }))
const h2Above3 = h2Above1 || prose0.top !== undefined
const words2 = headingLevels([team?.heading?.trim() ? `## ${team.heading.trim()}` : undefined, team?.intro].filter(Boolean).join('\n\n'), h2Above3 ? 2 : 1)
const h2Above5 = h2Above3 || (team && (teamItems?.length ?? 0) > 0 ? (!!team?.heading?.trim() || (team?.items?.length ?? 0) > 0) : words2.top !== undefined)
const prose4 = headingLevels(teamMore?.markdown, h2Above5 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {split && (
    <Split
      actions={splitActions}
      body={split.body}
      eyebrow={split.eyebrow}
      features={split.features}
      heading={split.heading}
      image={split.image}
      videoUrl={splitVideoUrl}
      playLabel={t('embed.play')}
      entry="split"
    />
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {team && (teamItems?.length ?? 0) > 0 ? (
    <Team
      heading={team.heading}
      intro={team.intro}
      items={teamItems}
      columns="4"
      entry="team"
    />
  ) : words2.markdown && (
    <div class="container-prose py-8" data-cr-shift={words2.shift}>
      <Prose markdown={words2.markdown} />
    </div>
  )}
  {teamMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose4.shift}>
      <Prose markdown={fitHeadings(prose4.markdown)} />
    </div>
  )}
</ComposedPage>
