---
// Generated by Contentrain Migrate from the plan route `page-cern-logistics`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Prose from '../../components/kit/prose/Prose.astro'
import Split from '../../components/kit/split/Split.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageCernLogistics = await getEntry('pageCernLogistics', 'en')
if (!pageCernLogistics) throw new Error('page-cern-logistics is missing: the page\'s sections are its fields')
const { text, cern_top_tips: cernTopTips, table_contents: tableContents, table_contents_note: tableContentsNote, arriving_cern: arrivingCern, travel, accommodation, amenities, technology, local_information: localInformation, out_about_geneva: outAboutGeneva, contacts } = pageCernLogistics.data
const textHtml = await publicHtml(text?.html)
const prose0 = headingLevels(text?.markdown, 1)
const cernTopTipsHtml = await publicHtml(cernTopTips?.html)
const h2Above2 = prose0.top !== undefined
const prose1 = headingLevels(cernTopTips?.markdown, h2Above2 ? 2 : 1)
const tableContentsHtml = await publicHtml(tableContents?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined
const prose3 = headingLevels(tableContents?.markdown, h2Above4 ? 2 : 1)
const tableContentsNoteHtml = await publicHtml(tableContentsNote?.html)
const h2Above6 = h2Above4 || prose3.top !== undefined
const prose5 = headingLevels(tableContentsNote?.markdown, h2Above6 ? 2 : 1)
const arrivingCernActions = (arrivingCern?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const arrivingCernVideoUrl = publicHref(arrivingCern?.video_url)
const travelHtml = await publicHtml(travel?.html)
const h2Above8 = h2Above6 || prose5.top !== undefined || !!(arrivingCern && (!!arrivingCern?.heading?.trim() || !!arrivingCern?.body || (arrivingCern?.features?.length ?? 0) > 0))
const prose7 = headingLevels(travel?.markdown, h2Above8 ? 2 : 1)
const accommodationHtml = await publicHtml(accommodation?.html)
const h2Above10 = h2Above8 || prose7.top !== undefined
const prose9 = headingLevels(accommodation?.markdown, h2Above10 ? 2 : 1)
const amenitiesHtml = await publicHtml(amenities?.html)
const h2Above12 = h2Above10 || prose9.top !== undefined
const prose11 = headingLevels(amenities?.markdown, h2Above12 ? 2 : 1)
const technologyHtml = await publicHtml(technology?.html)
const h2Above14 = h2Above12 || prose11.top !== undefined
const prose13 = headingLevels(technology?.markdown, h2Above14 ? 2 : 1)
const localInformationHtml = await publicHtml(localInformation?.html)
const h2Above16 = h2Above14 || prose13.top !== undefined
const prose15 = headingLevels(localInformation?.markdown, h2Above16 ? 2 : 1)
const outAboutGenevaHtml = await publicHtml(outAboutGeneva?.html)
const h2Above18 = h2Above16 || prose15.top !== undefined
const prose17 = headingLevels(outAboutGeneva?.markdown, h2Above18 ? 2 : 1)
const contactsHtml = await publicHtml(contacts?.html)
const h2Above20 = h2Above18 || prose17.top !== undefined
const prose19 = headingLevels(contacts?.markdown, h2Above20 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {cernTopTips && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose html={cernTopTipsHtml} markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {tableContents && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose html={tableContentsHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
  {tableContentsNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose5.shift}>
      <Prose html={tableContentsNoteHtml} markdown={fitHeadings(prose5.markdown)} />
    </div>
  )}
  {arrivingCern && (
    <Split
      actions={arrivingCernActions}
      body={arrivingCern.body}
      eyebrow={arrivingCern.eyebrow}
      features={arrivingCern.features}
      heading={arrivingCern.heading}
      image={arrivingCern.image}
      videoUrl={arrivingCernVideoUrl}
      playLabel={t('embed.play')}
      imageSide="end"
      entry="arriving_cern"
    />
  )}
  {travel && (
    <div id={"travel"} class="container-prose py-8" data-cr-fit data-cr-shift={prose7.shift}>
      <span id={"fromtheairport"}></span><Prose html={travelHtml} markdown={fitHeadings(prose7.markdown)} />
    </div>
  )}
  {accommodation && (
    <div id={"bytrainandbus"} class="container-prose py-8" data-cr-fit data-cr-shift={prose9.shift}>
      <span id={"bycar"}></span><span id={"aroundcampus"}></span><span id={"accommodation"}></span><span id={"receptionopeninghoursandcontactdetails:"}></span><Prose html={accommodationHtml} markdown={fitHeadings(prose9.markdown)} />
    </div>
  )}
  {amenities && (
    <div id={"amenities:"} class="container-prose py-8" data-cr-fit data-cr-shift={prose11.shift}>
      <Prose html={amenitiesHtml} markdown={fitHeadings(prose11.markdown)} />
    </div>
  )}
  {technology && (
    <div id={"technology"} class="container-prose py-8" data-cr-fit data-cr-shift={prose13.shift}>
      <span id={"internetaccess"}></span><span id={"plugs"}></span><span id={"usefulsmartphoneapps"}></span><Prose html={technologyHtml} markdown={fitHeadings(prose13.markdown)} />
    </div>
  )}
  {localInformation && (
    <div id={"localinformation"} class="container-prose py-8" data-cr-fit data-cr-shift={prose15.shift}>
      <span id={"outandabout:france"}></span><Prose html={localInformationHtml} markdown={fitHeadings(prose15.markdown)} />
    </div>
  )}
  {outAboutGeneva && (
    <div id={"outandabout:geneva"} class="container-prose py-8" data-cr-fit data-cr-shift={prose17.shift}>
      <span id={"emergencyinfo"}></span><Prose html={outAboutGenevaHtml} markdown={fitHeadings(prose17.markdown)} />
    </div>
  )}
  {contacts && (
    <div id={"contacts"} class="container-prose py-8" data-cr-fit data-cr-shift={prose19.shift}>
      <Prose html={contactsHtml} markdown={fitHeadings(prose19.markdown)} />
    </div>
  )}
</ComposedPage>
