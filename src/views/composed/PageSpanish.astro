---
// Generated by Contentrain Migrate from the plan route `page-spanish`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pageSpanish = await getEntry('pageSpanish', 'en')
if (!pageSpanish) throw new Error('page-spanish is missing: the page\'s sections are its fields')
const { hero, faq, faq_more: faqMore, gosh_democratiza_la: goshDemocratizaLa, gosh_no_tiene: goshNoTiene, gosh_empodera_la: goshEmpoderaLa, gosh_no_tiene_text: goshNoTieneText, gosh_es_herramientas: goshEsHerramientas, gosh_permite_multiples: goshPermiteMultiples } = pageSpanish.data
const heroActions = (hero?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const heroItems = (hero?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const faqActions = (faq?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const faqItems = (faq?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above1 = !!(hero && (!!hero?.heading?.trim() || (hero?.items?.length ?? 0) > 0)) || !!(faq && (!!faq?.heading?.trim() || (faq?.items?.length ?? 0) > 0))
const prose0 = headingLevels(faqMore?.markdown, h2Above1 ? 2 : 1)
const goshDemocratizaLaHtml = await publicHtml(goshDemocratizaLa?.html)
const h2Above3 = h2Above1 || prose0.top !== undefined
const prose2 = headingLevels(goshDemocratizaLa?.markdown, h2Above3 ? 2 : 1)
const goshNoTieneHtml = await publicHtml(goshNoTiene?.html)
const h2Above5 = h2Above3 || prose2.top !== undefined
const prose4 = headingLevels(goshNoTiene?.markdown, h2Above5 ? 2 : 1)
const goshEmpoderaLaHtml = await publicHtml(goshEmpoderaLa?.html)
const h2Above7 = h2Above5 || prose4.top !== undefined
const prose6 = headingLevels(goshEmpoderaLa?.markdown, h2Above7 ? 2 : 1)
const goshNoTieneTextHtml = await publicHtml(goshNoTieneText?.html)
const h2Above9 = h2Above7 || prose6.top !== undefined
const prose8 = headingLevels(goshNoTieneText?.markdown, h2Above9 ? 2 : 1)
const goshEsHerramientasHtml = await publicHtml(goshEsHerramientas?.html)
const h2Above11 = h2Above9 || prose8.top !== undefined
const prose10 = headingLevels(goshEsHerramientas?.markdown, h2Above11 ? 2 : 1)
const goshPermiteMultiplesHtml = await publicHtml(goshPermiteMultiples?.html)
const h2Above13 = h2Above11 || prose10.top !== undefined
const prose12 = headingLevels(goshPermiteMultiples?.markdown, h2Above13 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {hero && (
    <Band
      actions={heroActions}
      eyebrow={hero.eyebrow}
      heading={hero.heading}
      items={heroItems}
      lead={hero.lead}
      media={hero.media}
      tone="inverse"
      entry="hero"
    />
  )}
  {faq && (
    <Band
      actions={faqActions}
      eyebrow={faq.eyebrow}
      heading={faq.heading}
      items={faqItems}
      lead={faq.lead}
      media={faq.media}
      columns="4"
      entry="faq"
    />
  )}
  {faqMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {goshDemocratizaLa && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose html={goshDemocratizaLaHtml} markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
  {goshNoTiene && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose4.shift}>
      <Prose html={goshNoTieneHtml} markdown={fitHeadings(prose4.markdown)} />
    </div>
  )}
  {goshEmpoderaLa && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose6.shift}>
      <Prose html={goshEmpoderaLaHtml} markdown={fitHeadings(prose6.markdown)} />
    </div>
  )}
  {goshNoTieneText && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose8.shift}>
      <Prose html={goshNoTieneTextHtml} markdown={fitHeadings(prose8.markdown)} />
    </div>
  )}
  {goshEsHerramientas && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose10.shift}>
      <Prose html={goshEsHerramientasHtml} markdown={fitHeadings(prose10.markdown)} />
    </div>
  )}
  {goshPermiteMultiples && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose12.shift}>
      <Prose html={goshPermiteMultiplesHtml} markdown={fitHeadings(prose12.markdown)} />
    </div>
  )}
</ComposedPage>
