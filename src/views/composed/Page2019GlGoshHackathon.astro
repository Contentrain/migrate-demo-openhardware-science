---
// Generated by Contentrain Migrate from the plan route `page-2019-gl-gosh-hackathon`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const page2019GlGoshHackathon = await getEntry('page2019GlGoshHackathon', 'en')
if (!page2019GlGoshHackathon) throw new Error('page-2019-gl-gosh-hackathon is missing: the page\'s sections are its fields')
const { overview, overview_more: overviewMore } = page2019GlGoshHackathon.data
const overviewActions = (overview?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const overviewItems = (overview?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above1 = !!(overview && (!!overview?.heading?.trim() || (overview?.items?.length ?? 0) > 0))
const prose0 = headingLevels(overviewMore?.markdown, h2Above1 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {overview && (
    <Band
      actions={overviewActions}
      eyebrow={overview.eyebrow}
      heading={overview.heading}
      items={overviewItems}
      lead={overview.lead}
      media={overview.media}
      columns="2"
      entry="overview"
    />
  )}
  {overviewMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
</ComposedPage>
