---
// Generated by Contentrain Migrate from the plan route `page-2024-gosh-community-council-election`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const page2024GoshCommunityCouncilElection = await getEntry('page2024GoshCommunityCouncilElection', 'en')
if (!page2024GoshCommunityCouncilElection) throw new Error('page-2024-gosh-community-council-election is missing: the page\'s sections are its fields')
const { section, section_more: sectionMore, text } = page2024GoshCommunityCouncilElection.data
const sectionActions = (section?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const sectionItems = (section?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const h2Above1 = !!(section && (!!section?.heading?.trim() || (section?.items?.length ?? 0) > 0))
const prose0 = headingLevels(sectionMore?.markdown, h2Above1 ? 2 : 1)
const textHtml = await publicHtml(text?.html)
const h2Above3 = h2Above1 || prose0.top !== undefined
const prose2 = headingLevels(text?.markdown, h2Above3 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {section && (
    <Band
      actions={sectionActions}
      eyebrow={section.eyebrow}
      heading={section.heading}
      items={sectionItems}
      lead={section.lead}
      media={section.media}
      entry="section"
    />
  )}
  {sectionMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
</ComposedPage>
