---
// Generated by Contentrain Migrate from the plan route `page-portuguese`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Band from '../../components/kit/band/Band.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pagePortuguese = await getEntry('pagePortuguese', 'en')
if (!pagePortuguese) throw new Error('page-portuguese is missing: the page\'s sections are its fields')
const { hero, section, text, faq, faq_note: faqNote, gosh_nao_possui: goshNaoPossui, gosh_empodera_as: goshEmpoderaAs, gosh_nao_possui_text: goshNaoPossuiText, gosh_consiste_em: goshConsisteEm, gosh_garante_multiplos: goshGaranteMultiplos, gosh_garante_multiplos_note: goshGaranteMultiplosNote } = pagePortuguese.data
const heroActions = (hero?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const heroItems = (hero?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const sectionActions = (section?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const sectionItems = (section?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const textHtml = await publicHtml(text?.html)
const h2Above1 = !!(hero && (!!hero?.heading?.trim() || (hero?.items?.length ?? 0) > 0)) || !!(section && (!!section?.heading?.trim() || (section?.items?.length ?? 0) > 0))
const prose0 = headingLevels(text?.markdown, h2Above1 ? 2 : 1)
const faqActions = (faq?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const faqItems = (faq?.items ?? []).map(item => ({ href: publicHref(item.href), icon: item.icon, linkLabel: item.link_label, media: item.media, mediaAlt: item.media_alt, meta: item.meta, points: item.points, text: item.text, title: item.title, value: item.value }))
const faqNoteHtml = await publicHtml(faqNote?.html)
const h2Above3 = h2Above1 || prose0.top !== undefined || !!(faq && (!!faq?.heading?.trim() || (faq?.items?.length ?? 0) > 0))
const prose2 = headingLevels(faqNote?.markdown, h2Above3 ? 2 : 1)
const goshNaoPossuiHtml = await publicHtml(goshNaoPossui?.html)
const h2Above5 = h2Above3 || prose2.top !== undefined
const prose4 = headingLevels(goshNaoPossui?.markdown, h2Above5 ? 2 : 1)
const goshEmpoderaAsHtml = await publicHtml(goshEmpoderaAs?.html)
const h2Above7 = h2Above5 || prose4.top !== undefined
const prose6 = headingLevels(goshEmpoderaAs?.markdown, h2Above7 ? 2 : 1)
const goshNaoPossuiTextHtml = await publicHtml(goshNaoPossuiText?.html)
const h2Above9 = h2Above7 || prose6.top !== undefined
const prose8 = headingLevels(goshNaoPossuiText?.markdown, h2Above9 ? 2 : 1)
const goshConsisteEmHtml = await publicHtml(goshConsisteEm?.html)
const h2Above11 = h2Above9 || prose8.top !== undefined
const prose10 = headingLevels(goshConsisteEm?.markdown, h2Above11 ? 2 : 1)
const goshGaranteMultiplosHtml = await publicHtml(goshGaranteMultiplos?.html)
const h2Above13 = h2Above11 || prose10.top !== undefined
const prose12 = headingLevels(goshGaranteMultiplos?.markdown, h2Above13 ? 2 : 1)
const goshGaranteMultiplosNoteHtml = await publicHtml(goshGaranteMultiplosNote?.html)
const h2Above15 = h2Above13 || prose12.top !== undefined
const prose14 = headingLevels(goshGaranteMultiplosNote?.markdown, h2Above15 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {hero && (
    <Band
      actions={heroActions}
      eyebrow={hero.eyebrow}
      heading={hero.heading}
      items={heroItems}
      lead={hero.lead}
      media={hero.media}
      tone="inverse"
      entry="hero"
    />
  )}
  {section && (
    <Band
      actions={sectionActions}
      eyebrow={section.eyebrow}
      heading={section.heading}
      items={sectionItems}
      lead={section.lead}
      media={section.media}
      entry="section"
    />
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
  {faq && (
    <Band
      actions={faqActions}
      eyebrow={faq.eyebrow}
      heading={faq.heading}
      items={faqItems}
      lead={faq.lead}
      media={faq.media}
      columns="4"
      entry="faq"
    />
  )}
  {faqNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose2.shift}>
      <Prose html={faqNoteHtml} markdown={fitHeadings(prose2.markdown)} />
    </div>
  )}
  {goshNaoPossui && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose4.shift}>
      <Prose html={goshNaoPossuiHtml} markdown={fitHeadings(prose4.markdown)} />
    </div>
  )}
  {goshEmpoderaAs && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose6.shift}>
      <Prose html={goshEmpoderaAsHtml} markdown={fitHeadings(prose6.markdown)} />
    </div>
  )}
  {goshNaoPossuiText && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose8.shift}>
      <Prose html={goshNaoPossuiTextHtml} markdown={fitHeadings(prose8.markdown)} />
    </div>
  )}
  {goshConsisteEm && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose10.shift}>
      <Prose html={goshConsisteEmHtml} markdown={fitHeadings(prose10.markdown)} />
    </div>
  )}
  {goshGaranteMultiplos && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose12.shift}>
      <Prose html={goshGaranteMultiplosHtml} markdown={fitHeadings(prose12.markdown)} />
    </div>
  )}
  {goshGaranteMultiplosNote && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose14.shift}>
      <Prose html={goshGaranteMultiplosNoteHtml} markdown={fitHeadings(prose14.markdown)} />
    </div>
  )}
</ComposedPage>
