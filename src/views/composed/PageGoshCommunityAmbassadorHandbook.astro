---
// Generated by Contentrain Migrate from the plan route `page-gosh-community-ambassador-handbook`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Prose from '../../components/kit/prose/Prose.astro'
import Split from '../../components/kit/split/Split.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageGoshCommunityAmbassadorHandbook = await getEntry('pageGoshCommunityAmbassadorHandbook', 'en')
if (!pageGoshCommunityAmbassadorHandbook) throw new Error('page-gosh-community-ambassador-handbook is missing: the page\'s sections are its fields')
const { handbook_available_three: handbookAvailableThree, handbook_available_three_more: handbookAvailableThreeMore } = pageGoshCommunityAmbassadorHandbook.data
const handbookAvailableThreeActions = (handbookAvailableThree?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const handbookAvailableThreeVideoUrl = publicHref(handbookAvailableThree?.video_url)
const h2Above1 = !!(handbookAvailableThree && (!!handbookAvailableThree?.heading?.trim() || !!handbookAvailableThree?.body || (handbookAvailableThree?.features?.length ?? 0) > 0))
const prose0 = headingLevels(handbookAvailableThreeMore?.markdown, h2Above1 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {handbookAvailableThree && (
    <Split
      actions={handbookAvailableThreeActions}
      body={handbookAvailableThree.body}
      eyebrow={handbookAvailableThree.eyebrow}
      features={handbookAvailableThree.features}
      heading={handbookAvailableThree.heading}
      image={handbookAvailableThree.image}
      videoUrl={handbookAvailableThreeVideoUrl}
      playLabel={t('embed.play')}
      imageSide="end"
      entry="handbook_available_three"
    />
  )}
  {handbookAvailableThreeMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose0.shift}>
      <Prose markdown={fitHeadings(prose0.markdown)} />
    </div>
  )}
</ComposedPage>
