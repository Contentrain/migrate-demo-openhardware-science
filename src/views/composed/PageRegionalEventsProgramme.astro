---
// Generated by Contentrain Migrate from the plan route `page-regional-events-programme`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Split from '../../components/kit/split/Split.astro'
import { getStrings, type Page } from '../../lib/content'
import { publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageRegionalEventsProgramme = await getEntry('pageRegionalEventsProgramme', 'en')
if (!pageRegionalEventsProgramme) throw new Error('page-regional-events-programme is missing: the page\'s sections are its fields')
const { split } = pageRegionalEventsProgramme.data
const splitActions = (split?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const splitVideoUrl = publicHref(split?.video_url)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {split && (
    <Split
      actions={splitActions}
      body={split.body}
      eyebrow={split.eyebrow}
      features={split.features}
      heading={split.heading}
      image={split.image}
      videoUrl={splitVideoUrl}
      playLabel={t('embed.play')}
      entry="split"
    />
  )}
</ComposedPage>
