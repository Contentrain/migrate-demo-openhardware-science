---
// GOSH 2026 Kathmandu: the announcement opens the page with the date line as a solid GOSH-purple tile, the host
// beside the Durbar Square photographs, the details as a report grid, travel set in the reading column.
import { getEntry } from 'astro:content'
import CardGrid from '../../components/kit/card-grid/CardGrid.astro'
import Hero from '../../components/kit/hero/Hero.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'
import '../../styles/page-gosh-2026-kathmandu-nepal.css'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const entry = await getEntry('pageGosh2026KathmanduNepal', 'en')
if (!entry) throw new Error('page-gosh-2026-kathmandu-nepal is missing: the page\'s sections are its fields')
const { hero, hero_more: heroMore, text, card_grid: cardGrid, card_grid_more: cardGridMore, travel_information: travelInformation, travel_information_note: travelInformationNote, travel_information_note_2: travelInformationNote2 } = entry.data
const heroActions = (hero?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const opensWithHeading = !!hero?.heading?.trim()
const heroWords = headingLevels([hero?.heading?.trim() ? `## ${hero.heading.trim()}` : undefined, hero?.eyebrow, hero?.lead].filter(Boolean).join('\n\n'), 1)
const heroMoreProse = headingLevels(heroMore?.markdown, 2)
const textHtml = await publicHtml(text?.html)
const textProse = headingLevels(text?.markdown, 2)
const cardGridItems = (cardGrid?.items ?? []).map(item => ({ eyebrow: item.eyebrow, href: publicHref(item.href), icon: item.icon, image: item.image, imageAlt: item.image_alt, linkLabel: item.link_label, text: item.text, title: item.title }))
const cardWords = headingLevels([cardGrid?.title?.trim() ? `## ${cardGrid.title.trim()}` : undefined, cardGrid?.intro].filter(Boolean).join('\n\n'), 2)
const cardGridMoreProse = headingLevels(cardGridMore?.markdown, 2)
const travelHtml = await publicHtml(travelInformation?.html)
const travelProse = headingLevels(travelInformation?.markdown, 2)
const noteHtml = await publicHtml(travelInformationNote?.html)
const noteProse = headingLevels(travelInformationNote?.markdown, 2)
const note2Html = await publicHtml(travelInformationNote2?.html)
const note2Prose = headingLevels(travelInformationNote2?.markdown, 2)
const hasPlace = !!heroMore || !!text
---
<ComposedPage page={page} trail={trail} isHome={isHome} showTitle={!opensWithHeading}>
  <div class="gk-page">
    {hero && hero.heading !== undefined ? (
      <div class="gk-hero" data-cr-split>
        <Hero
          actions={heroActions}
          eyebrow={hero.eyebrow}
          heading={hero.heading}
          image={hero.image}
          items={hero.items}
          lead={hero.lead}
          level={opensWithHeading ? 1 : 2}
          stackOrder="media-first"
          entry="hero"
        />
      </div>
    ) : heroWords.markdown && (
      <div class="container-prose py-8" data-cr-shift={heroWords.shift}>
        <Prose markdown={heroWords.markdown} />
      </div>
    )}

    {hasPlace && (
      <div class="container-page gk-band gk-band--flush">
        <div class="gk-place">
          {heroMore && (
            <div class="gk-host" data-cr-shift={heroMoreProse.shift}>
              <Prose markdown={fitHeadings(heroMoreProse.markdown)} size="base" />
            </div>
          )}
          {text && (
            <div class="gk-photos" data-cr-shift={textProse.shift}>
              <Prose html={textHtml} markdown={fitHeadings(textProse.markdown)} size="base" />
            </div>
          )}
        </div>
      </div>
    )}

    {cardGrid && cardGridItems.length > 0 ? (
      <CardGrid
        intro={cardGrid.intro}
        items={cardGridItems}
        title={cardGrid.title}
        columns="3"
        entry="card_grid"
      />
    ) : cardWords.markdown && (
      <div class="container-prose py-8" data-cr-shift={cardWords.shift}>
        <Prose markdown={cardWords.markdown} />
      </div>
    )}

    {(cardGridMore || travelInformationNote) && (
      <div class="container-page pb-16">
        <div class="gk-notes">
          {cardGridMore && (
            <div data-cr-shift={cardGridMoreProse.shift}>
              <Prose markdown={fitHeadings(cardGridMoreProse.markdown)} size="base" />
            </div>
          )}
          {travelInformationNote && (
            <div data-cr-shift={noteProse.shift}>
              <Prose html={noteHtml} markdown={fitHeadings(noteProse.markdown)} size="base" />
            </div>
          )}
        </div>
      </div>
    )}

    {travelInformation && (
      <div class="gk-travel gk-band bg-surface-muted">
        <div class="container-prose" data-cr-shift={travelProse.shift}>
          <Prose html={travelHtml} markdown={fitHeadings(travelProse.markdown)} size="base" />
        </div>
      </div>
    )}

    {travelInformationNote2 && (
      <div class="gk-closing container-page gk-band" data-cr-shift={note2Prose.shift}>
        <Prose html={note2Html} markdown={fitHeadings(note2Prose.markdown)} size="base" />
      </div>
    )}
  </div>
</ComposedPage>
