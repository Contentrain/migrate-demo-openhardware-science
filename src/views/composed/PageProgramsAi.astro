---
// /programs/: the GOSH funding programmes as a printed report index. The hero states the
// promise, a solid purple report tile carries the Roadmap the programmes serve, and the five
// funds follow as a photo-led index. Every word comes from the page-programs entry.
import { getEntry } from 'astro:content'
import CardGrid from '../../components/kit/card-grid/CardGrid.astro'
import Hero from '../../components/kit/hero/Hero.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import { type Page } from '../../lib/content'
import { headingFit } from '../../lib/heading-fit'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

const { page, trail } = Astro.props
const isHome = false
const publicHref = await publicLinks()
const pagePrograms = await getEntry('pagePrograms', 'en')
if (!pagePrograms) throw new Error('page-programs is missing: the page\'s sections are its fields')
const { hero, hero_more: heroMore, card_grid: cardGrid } = pagePrograms.data
const heroActions = (hero?.actions ?? []).flatMap(item => { const href = publicHref(item.href); return href === undefined ? [] : [{ href, label: item.label, newTab: item.new_tab, style: item.style }] })
const words0 = headingLevels([hero?.heading?.trim() ? `## ${hero.heading.trim()}` : undefined, hero?.eyebrow, hero?.lead].filter(Boolean).join('\n\n'), 1)
const h2Above2 = (hero && hero.heading !== undefined ? (!!hero?.heading?.trim() || (hero?.items?.length ?? 0) > 0) : words0.top !== undefined)
const prose1 = headingLevels(heroMore?.markdown, h2Above2 ? 2 : 1)
const cardGridItems = (cardGrid?.items ?? []).map(item => ({ eyebrow: item.eyebrow, href: publicHref(item.href), icon: item.icon, image: item.image, imageAlt: item.image_alt, linkLabel: item.link_label, text: item.text, title: item.title }))
const h2Above4 = h2Above2 || prose1.top !== undefined
const words3 = headingLevels([cardGrid?.title?.trim() ? `## ${cardGrid.title.trim()}` : undefined, cardGrid?.intro].filter(Boolean).join('\n\n'), h2Above4 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {hero && hero.heading !== undefined ? (
    <div class="contents" data-cr-hero style={headingFit(hero.heading)} data-cr-split>
      <Hero
        actions={heroActions}
        eyebrow={hero.eyebrow}
        heading={hero.heading}
        image={hero.image}
        items={hero.items}
        lead={hero.lead}
        level={2}
        imageBleed="edge"
        entry="hero"
      />
    </div>
  ) : words0.markdown && (
    <div class="container-prose py-8" data-cr-shift={words0.shift}>
      <Prose markdown={words0.markdown} />
    </div>
  )}
  {heroMore?.markdown && (
    <div class="container-page" data-cr-fit data-cr-shift={prose1.shift}>
      <div class="bg-accent px-6 py-10 text-accent-ink md:ms-[27%] md:px-12 md:py-14 [&_*]:!text-accent-ink [&_a]:underline [&_a]:decoration-2 [&_a]:underline-offset-8 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-accent-ink [&_p]:!m-0 [&_p]:!text-[length:var(--text-heading-2)] [&_p]:!leading-[1.1] [&_p]:!font-extrabold [&_p]:tracking-[-0.03em]">
        <Prose markdown={fitHeadings(prose1.markdown)} />
      </div>
    </div>
  )}
  {cardGrid && (cardGridItems?.length ?? 0) > 0 ? (
    <CardGrid
      intro={cardGrid.intro}
      items={cardGridItems}
      title={cardGrid.title}
      columns="4"
      entry="card_grid"
    />
  ) : words3.markdown && (
    <div class="container-prose py-8" data-cr-shift={words3.shift}>
      <Prose markdown={words3.markdown} />
    </div>
  )}
</ComposedPage>
