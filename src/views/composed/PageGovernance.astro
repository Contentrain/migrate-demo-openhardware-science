---
// Generated by Contentrain Migrate from the plan route `page-governance`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import Gallery from '../../components/kit/gallery/Gallery.astro'
import Prose from '../../components/kit/prose/Prose.astro'
import Team from '../../components/kit/team/Team.astro'
import { getStrings, type Page } from '../../lib/content'
import { fitHeadings, headingLevels } from '../../lib/headings'
import { publicHtml, publicLinks } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

// The plan decided the page's h1 for a page that is not the home page; the frame follows it.
const { page, trail } = Astro.props
const isHome = false
const t = await getStrings()
const publicHref = await publicLinks()
const pageGovernance = await getEntry('pageGovernance', 'en')
if (!pageGovernance) throw new Error('page-governance is missing: the page\'s sections are its fields')
const { gallery, gallery_more: galleryMore, community, team, team_more: teamMore, text, council_domains: councilDomains, community_coordinator: communityCoordinator, organisations_supporting_gosh: organisationsSupportingGosh } = pageGovernance.data
const galleryItems = (gallery?.items ?? []).map(item => ({ caption: item.caption, full: item.full, image: item.image, imageAlt: item.image_alt }))
const words0 = headingLevels([gallery?.heading?.trim() ? `## ${gallery.heading.trim()}` : undefined].filter(Boolean).join('\n\n'), 1)
const h2Above2 = (gallery && (galleryItems?.length ?? 0) > 0 ? (!!gallery?.heading?.trim()) : words0.top !== undefined)
const prose1 = headingLevels(galleryMore?.markdown, h2Above2 ? 2 : 1)
const communityHtml = await publicHtml(community?.html)
const h2Above4 = h2Above2 || prose1.top !== undefined
const prose3 = headingLevels(community?.markdown, h2Above4 ? 2 : 1)
const teamItems = (team?.items ?? []).map(item => ({ bio: item.bio, href: publicHref(item.href), image: item.image, imageAlt: item.image_alt, links: (item.links ?? []).flatMap(url => publicHref(url) ?? []), name: item.name, role: item.role }))
const h2Above6 = h2Above4 || prose3.top !== undefined
const words5 = headingLevels([team?.heading?.trim() ? `## ${team.heading.trim()}` : undefined, team?.intro].filter(Boolean).join('\n\n'), h2Above6 ? 2 : 1)
const h2Above8 = h2Above6 || (team && (teamItems?.length ?? 0) > 0 ? (!!team?.heading?.trim() || (team?.items?.length ?? 0) > 0) : words5.top !== undefined)
const prose7 = headingLevels(teamMore?.markdown, h2Above8 ? 2 : 1)
const textHtml = await publicHtml(text?.html)
const h2Above10 = h2Above8 || prose7.top !== undefined
const prose9 = headingLevels(text?.markdown, h2Above10 ? 2 : 1)
const councilDomainsHtml = await publicHtml(councilDomains?.html)
const h2Above12 = h2Above10 || prose9.top !== undefined
const prose11 = headingLevels(councilDomains?.markdown, h2Above12 ? 2 : 1)
const communityCoordinatorHtml = await publicHtml(communityCoordinator?.html)
const h2Above14 = h2Above12 || prose11.top !== undefined
const prose13 = headingLevels(communityCoordinator?.markdown, h2Above14 ? 2 : 1)
const organisationsSupportingGoshHtml = await publicHtml(organisationsSupportingGosh?.html)
const h2Above16 = h2Above14 || prose13.top !== undefined
const prose15 = headingLevels(organisationsSupportingGosh?.markdown, h2Above16 ? 2 : 1)
---
<ComposedPage page={page} trail={trail} isHome={isHome}>
  {gallery && (galleryItems?.length ?? 0) > 0 ? (
    <Gallery
      heading={gallery.heading}
      items={galleryItems}
      closeLabel={t('gallery.close')}
      prevLabel={t('slider.prev')}
      nextLabel={t('slider.next')}
      ofLabel={t('slider.of')}
      enlargeLabel={t('gallery.enlarge')}
      regionLabel={t('gallery.images')}
      columns="3"
      entry="gallery"
    />
  ) : words0.markdown && (
    <div class="container-prose py-8" data-cr-shift={words0.shift}>
      <Prose markdown={words0.markdown} />
    </div>
  )}
  {galleryMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose1.shift}>
      <Prose markdown={fitHeadings(prose1.markdown)} />
    </div>
  )}
  {community && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose3.shift}>
      <Prose html={communityHtml} markdown={fitHeadings(prose3.markdown)} />
    </div>
  )}
  {team && (teamItems?.length ?? 0) > 0 ? (
    <Team
      heading={team.heading}
      intro={team.intro}
      items={teamItems}
      columns="4"
      entry="team"
    />
  ) : words5.markdown && (
    <div class="container-prose py-8" data-cr-shift={words5.shift}>
      <Prose markdown={words5.markdown} />
    </div>
  )}
  {teamMore && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose7.shift}>
      <Prose markdown={fitHeadings(prose7.markdown)} />
    </div>
  )}
  {text && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose9.shift}>
      <Prose html={textHtml} markdown={fitHeadings(prose9.markdown)} />
    </div>
  )}
  {councilDomains && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose11.shift}>
      <Prose html={councilDomainsHtml} markdown={fitHeadings(prose11.markdown)} />
    </div>
  )}
  {communityCoordinator && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose13.shift}>
      <Prose html={communityCoordinatorHtml} markdown={fitHeadings(prose13.markdown)} />
    </div>
  )}
  {organisationsSupportingGosh && (
    <div class="container-prose py-8" data-cr-fit data-cr-shift={prose15.shift}>
      <Prose html={organisationsSupportingGoshHtml} markdown={fitHeadings(prose15.markdown)} />
    </div>
  )}
</ComposedPage>
