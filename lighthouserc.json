{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/(404\\.html|search/(index\\.html)?)$)(?!https?://[^/]+/(index\\.html)?$)(?!.*/(2021-gosh-community-council-elections|2022-gosh-community-council-election|2021-research-funding-salons)/(index\\.html)?$).*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/(index\\.html)?$|.*/(2021-gosh-community-council-elections|2022-gosh-community-council-election)/(index\\.html)?$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 0.92 }]
          }
        },
        {
          "matchingUrlPattern": ".*/2021-research-funding-salons/(index\\.html)?$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.96 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 0.92 }]
          }
        },
        {
          "matchingUrlPattern": ".*/(404\\.html|search/(index\\.html)?)$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
