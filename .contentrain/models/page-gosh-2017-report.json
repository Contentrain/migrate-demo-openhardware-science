        "address": {
          "description": "A place or address shown on a Google map when there is no url.",
          "label": "Address",
          "required": false,
          "type": "string"
        },
        "caption": {
          "description": "A line under the embed.",
          "label": "Caption",
          "required": false,
          "type": "string"
        },
        "play_label": {
          "description": "Poster action for a video or audio player.",
          "label": "Play label",
          "required": false,
          "type": "string"
        },
        "poster": {
          "description": "Local poster image.",
          "fields": {
            "alt": {
              "description": "Alt text of the poster.",
              "label": "Alt text",
              "required": true,
              "type": "string"
            },
            "height": {
              "description": "Height of the poster.",
              "label": "Height",
              "type": "integer"
            },
            "src": {
              "description": "Image of the poster.",
              "label": "Image",
              "required": true,
              "type": "image"
            },
            "width": {
              "description": "Width of the poster.",
              "label": "Width",
              "type": "integer"
            }
          },
          "label": "Poster",
          "required": false,
          "type": "object"
        },
        "show_label": {
          "description": "Poster action for a map or widget.",
          "label": "Show label",
          "required": false,
          "type": "string"
        },
        "title": {
          "description": "What it is: the player's accessible name and the poster's text.",
          "label": "Title",
          "required": false,
          "type": "string"
        },
        "uploaded": {
          "description": "The video's upload date, printed as uploadDate only when the source states it.",
          "label": "Uploaded",
          "required": false,
          "type": "string"
        },
        "url": {
          "description": "A video page or a known provider's embed address.",
          "label": "Link",
          "required": false,
          "type": "url"
        }
      },
      "label": "Embed",
      "type": "object"
    },
    "hero": {
