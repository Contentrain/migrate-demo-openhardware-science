                "label": "Label",
                "required": true,
                "type": "string"
              },
              "new_tab": {
                "description": "Open the link in a new tab.",
                "label": "Open in a new tab",
                "type": "boolean"
              },
              "style": {
                "description": "primary for the main action, secondary or ghost for the ones beside it.",
                "label": "Style",
                "options": [
                  "primary",
                  "secondary",
                  "ghost"
                ],
                "type": "select"
              }
            },
            "type": "object"
          },
          "label": "Buttons",
          "required": false,
          "type": "array"
        },
        "eyebrow": {
          "description": "Short line above the heading.",
          "label": "Eyebrow",
          "required": false,
          "type": "string"
        },
        "heading": {
          "description": "The main heading.",
          "label": "Heading",
          "required": true,
          "type": "string"
        },
        "image": {
          "description": "Hero image; loaded first.",
          "fields": {
            "alt": {
              "description": "What the image shows, for readers who cannot see it; empty when it is decoration.",
              "label": "Image description",
              "type": "string"
            },
            "height": {
              "description": "Height in pixels, as uploaded.",
              "label": "Height",
              "type": "integer"
            },
            "src": {
              "description": "The image file.",
              "label": "Image",
              "required": true,
              "type": "image"
            },
            "width": {
              "description": "Width in pixels, as uploaded.",
              "label": "Width",
              "type": "integer"
            }
          },
          "label": "Image",
          "required": false,
          "type": "object"
        },
        "items": {
          "description": "Short points under the lead, before the buttons, in order: a hero's feature or promise list.",
          "items": {
            "fields": {
              "icon": {
                "description": "A small image before the text.",
                "label": "Icon",
                "type": "image"
              },
              "title": {
                "description": "A short promise or feature.",
                "label": "Text",
                "required": true,
                "type": "string"
              }
            },
            "type": "object"
          },
          "label": "Points",
          "required": false,
          "type": "array"
        },
        "lead": {
          "description": "Paragraph under the heading.",
          "label": "Lead",
          "required": false,
